---
/**
 * FeaturedCarousel - Auto-rotating testimonial/press quote carousel
 * Inspired by Kristian Alexander's rotating testimonials
 *
 * Features:
 * - Auto-rotation (pauses on hover)
 * - Navigation arrows + dots
 * - Smooth fade transitions
 * - Accessible keyboard navigation
 * - Dynamic height based on tallest slide
 */

interface Quote {
  text: string;
  publication: string;
  author?: string;
}

interface Props {
  quotes: Quote[];
  interval?: number; // ms between rotations
}

const { quotes, interval = 5000 } = Astro.props;
---

<div
  class="featured-carousel relative"
  data-interval={interval}
  role="region"
  aria-label="Featured press quotes"
>
  <!-- Quotes Container - uses grid stacking for proper height calculation -->
  <div class="carousel-slides grid">
    {
      quotes.map((quote, index) => (
        <blockquote
          class={`carousel-slide col-start-1 row-start-1 transition-all duration-700 ease-out ${
            index === 0 ? 'opacity-100 visible' : 'opacity-0 invisible pointer-events-none'
          }`}
          data-slide={index}
          aria-hidden={index !== 0}
        >
          <p class="text-xl md:text-2xl lg:text-3xl font-serif italic leading-relaxed mb-6">
            "{quote.text}"
          </p>
          <cite class="text-nav text-muted-foreground not-italic block">
            — {quote.publication}
            {quote.author && `, ${quote.author}`}
          </cite>
        </blockquote>
      ))
    }
  </div>

  <!-- Navigation -->
  <div class="flex items-center justify-between mt-8 pt-6 border-t border-border/50">
    <!-- Dots -->
    <div class="flex gap-1.5" role="tablist" aria-label="Carousel navigation">
      {
        quotes.map((_, index) => (
          <button
            class={`carousel-dot h-1.5 rounded-full transition-all duration-300 ${
              index === 0 ? 'bg-primary w-5' : 'bg-border hover:bg-muted-foreground w-1.5'
            }`}
            data-dot={index}
            role="tab"
            aria-selected={index === 0}
            aria-label={`Go to quote ${index + 1}`}
          />
        ))
      }
    </div>

    <!-- Arrows -->
    <div class="flex gap-2">
      <button
        class="carousel-prev p-2 rounded-full border border-border hover:border-primary hover:text-primary transition-colors duration-300"
        aria-label="Previous quote"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
          ></path>
        </svg>
      </button>
      <button
        class="carousel-next p-2 rounded-full border border-border hover:border-primary hover:text-primary transition-colors duration-300"
        aria-label="Next quote"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  class FeaturedCarousel {
    container: HTMLElement;
    slides: NodeListOf<HTMLElement>;
    dots: NodeListOf<HTMLButtonElement>;
    prevBtn: HTMLButtonElement;
    nextBtn: HTMLButtonElement;
    currentIndex: number = 0;
    interval: number;
    timer: number | null = null;
    isPaused: boolean = false;

    constructor(container: HTMLElement) {
      this.container = container;
      this.slides = container.querySelectorAll('.carousel-slide');
      this.dots = container.querySelectorAll('.carousel-dot');
      this.prevBtn = container.querySelector('.carousel-prev')!;
      this.nextBtn = container.querySelector('.carousel-next')!;
      this.interval = parseInt(container.dataset.interval || '5000');

      this.init();
    }

    init() {
      // Arrow navigation
      this.prevBtn.addEventListener('click', () => this.prev());
      this.nextBtn.addEventListener('click', () => this.next());

      // Dot navigation
      this.dots.forEach((dot, index) => {
        dot.addEventListener('click', () => this.goTo(index));
      });

      // Pause on hover
      this.container.addEventListener('mouseenter', () => {
        this.isPaused = true;
        this.stopAutoPlay();
      });

      this.container.addEventListener('mouseleave', () => {
        this.isPaused = false;
        this.startAutoPlay();
      });

      // Keyboard navigation
      this.container.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') this.prev();
        if (e.key === 'ArrowRight') this.next();
      });

      // Start auto-rotation
      this.startAutoPlay();
    }

    goTo(index: number) {
      // Hide current
      this.slides[this.currentIndex].classList.remove('opacity-100', 'visible');
      this.slides[this.currentIndex].classList.add('opacity-0', 'invisible', 'pointer-events-none');
      this.slides[this.currentIndex].setAttribute('aria-hidden', 'true');

      this.dots[this.currentIndex].classList.remove('bg-primary', 'w-5');
      this.dots[this.currentIndex].classList.add('bg-border', 'w-1.5');
      this.dots[this.currentIndex].setAttribute('aria-selected', 'false');

      // Show new
      this.currentIndex = index;
      this.slides[this.currentIndex].classList.add('opacity-100', 'visible');
      this.slides[this.currentIndex].classList.remove(
        'opacity-0',
        'invisible',
        'pointer-events-none'
      );
      this.slides[this.currentIndex].setAttribute('aria-hidden', 'false');

      this.dots[this.currentIndex].classList.add('bg-primary', 'w-5');
      this.dots[this.currentIndex].classList.remove('bg-border', 'w-1.5');
      this.dots[this.currentIndex].setAttribute('aria-selected', 'true');
    }

    next() {
      const nextIndex = (this.currentIndex + 1) % this.slides.length;
      this.goTo(nextIndex);
    }

    prev() {
      const prevIndex = (this.currentIndex - 1 + this.slides.length) % this.slides.length;
      this.goTo(prevIndex);
    }

    startAutoPlay() {
      if (this.timer) return;
      this.timer = window.setInterval(() => {
        if (!this.isPaused) this.next();
      }, this.interval);
    }

    stopAutoPlay() {
      if (this.timer) {
        clearInterval(this.timer);
        this.timer = null;
      }
    }
  }

  // Initialize all carousels on the page
  document.querySelectorAll('.featured-carousel').forEach((el) => {
    new FeaturedCarousel(el as HTMLElement);
  });
</script>
