---
/**
 * MediaVideo - Video player with YouTube/Vimeo embed support
 *
 * Usage:
 * <MediaVideo
 *   video={{
 *     src: 'https://youtube.com/watch?v=...',
 *     title: 'Beethoven Symphony No. 9 - Live',
 *     platform: 'youtube',
 *     embedUrl: 'https://www.youtube.com/embed/...'
 *   }}
 * />
 */

interface Props {
  video: {
    src: string;
    title: string;
    duration?: string;
    description?: string;
    thumbnail?: string;
    platform?: 'youtube' | 'vimeo' | 'self-hosted' | 'other';
    embedUrl?: string;
  };
  aspectRatio?: '16/9' | '4/3' | '1/1' | '9/16';
  autoplay?: boolean;
  class?: string;
}

const { video, aspectRatio = '16/9', autoplay = false, class: className = '' } = Astro.props;

// Detect if we should use an embed or native player
const useEmbed = video.embedUrl && video.platform !== 'self-hosted';
const useNativePlayer = video.platform === 'self-hosted';

// Build embed URL with parameters
function getEmbedUrl() {
  if (!video.embedUrl) return '';
  let url = video.embedUrl;

  // Add common embed parameters
  const params = new URLSearchParams();
  if (autoplay) params.set('autoplay', '1');

  // Platform-specific params
  if (video.platform === 'youtube') {
    params.set('rel', '0'); // Don't show related videos from other channels
    params.set('modestbranding', '1');
  } else if (video.platform === 'vimeo') {
    params.set('byline', '0');
    params.set('portrait', '0');
  }

  const paramString = params.toString();
  if (paramString) {
    url += (url.includes('?') ? '&' : '?') + paramString;
  }

  return url;
}

const embedUrl = getEmbedUrl();

const aspectClasses = {
  '16/9': 'aspect-video',
  '4/3': 'aspect-[4/3]',
  '1/1': 'aspect-square',
  '9/16': 'aspect-[9/16]',
};
---

<div class:list={['media-video', className]}>
  <div class:list={['relative rounded-md overflow-hidden bg-muted', aspectClasses[aspectRatio]]}>
    {/* Embedded player (YouTube, Vimeo) */}
    {
      useEmbed && embedUrl && (
        <iframe
          src={embedUrl}
          title={video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
          class="absolute inset-0 w-full h-full border-0"
        />
      )
    }

    {/* Native HTML5 video player */}
    {
      useNativePlayer && (
        <video
          controls
          preload="metadata"
          poster={video.thumbnail}
          class="absolute inset-0 w-full h-full object-contain bg-black"
        >
          <source src={video.src} type="video/mp4" />
          <source src={video.src} type="video/webm" />
          Your browser does not support the video element.
        </video>
      )
    }

    {/* Thumbnail with play button (for non-embed external links) */}
    {
      !useEmbed && !useNativePlayer && (
        <a
          href={video.src}
          target="_blank"
          rel="noopener noreferrer"
          class="group absolute inset-0 flex items-center justify-center"
          aria-label={`Watch ${video.title}`}
        >
          {video.thumbnail ? (
            <img
              src={video.thumbnail}
              alt=""
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          ) : (
            <div class="absolute inset-0 bg-muted" />
          )}

          {/* Play button overlay */}
          <div class="relative z-10 w-16 h-16 md:w-20 md:h-20 rounded-full bg-primary/90 group-hover:bg-primary flex items-center justify-center transition-all duration-300 group-hover:scale-110 shadow-lg">
            <svg
              class="w-6 h-6 md:w-8 md:h-8 text-primary-foreground ml-1"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M8 5v14l11-7z" />
            </svg>
          </div>

          {/* Dark overlay on hover */}
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300" />
        </a>
      )
    }
  </div>

  {/* Video info */}
  <div class="mt-3">
    <h4 class="font-medium">{video.title}</h4>
    {video.duration && <p class="text-sm text-muted-foreground">{video.duration}</p>}
    {video.description && <p class="text-sm text-muted-foreground mt-1">{video.description}</p>}
  </div>
</div>
