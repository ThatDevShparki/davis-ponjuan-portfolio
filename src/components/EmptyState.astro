---
interface Props {
  title: string;
  message?: string;
  actionText?: string;
  actionHref?: string;
}

const { title, message, actionText, actionHref } = Astro.props;
---

<div class="empty-state text-center py-16 px-8 text-gray-600">
  <h3 class="text-xl mb-2 text-gray-800">{title}</h3>
  {message && <p class="text-base mb-6">{message}</p>}
  {
    actionText && actionHref && (
      <a
        href={actionHref}
        class="inline-block py-3 px-6 bg-[#2d7a3e] text-white no-underline rounded font-semibold hover:bg-[#246330] transition-colors"
      >
        {actionText}
      </a>
    )
  }
</div>
