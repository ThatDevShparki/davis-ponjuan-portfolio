---
interface Props {
  title: string;
  message?: string;
  actionText?: string;
  actionHref?: string;
}

const { title, message, actionText, actionHref } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-16 px-8 text-center">
  <h3 class="text-xl font-semibold text-foreground mb-2">{title}</h3>
  {message && <p class="text-base text-muted-foreground mb-6 max-w-md">{message}</p>}
  {
    actionText && actionHref && (
      <a href={actionHref} class="btn-primary">
        {actionText}
      </a>
    )
  }
</div>
