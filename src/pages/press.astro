---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allPress = await getCollection('press');
const sortedPress = allPress.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Press - Davis Ponjuan" description="Press coverage and reviews">
  <h1 class="text-5xl mb-4">Press & Reviews</h1>

  <p class="text-lg leading-relaxed mb-12 text-muted-foreground">
    Selected press coverage and critical reviews of performances throughout my career.
  </p>

  <ul class="list-none p-0">
    {
      sortedPress.map(async (item) => {
        const { Content } = await item.render();
        return (
          <li class="list-divider mb-12 pb-12">
            <article>
              <h2 class="text-2xl mb-3">{item.data.title}</h2>
              <div class="metadata mb-4">
                <strong>{item.data.publication}</strong>
                {item.data.author && (
                  <>
                    <span class="metadata-separator" />
                    {item.data.author}
                  </>
                )}
                <span class="metadata-separator" />
                <time datetime={item.data.date.toISOString()}>
                  {item.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {item.data.url && (
                  <>
                    <span class="metadata-separator" />
                    <a
                      href={item.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-primary"
                    >
                      Read full article
                    </a>
                  </>
                )}
              </div>
              <blockquote class="press-quote">{item.data.excerpt}</blockquote>
              <div class="leading-relaxed text-muted-foreground">
                <Content />
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
