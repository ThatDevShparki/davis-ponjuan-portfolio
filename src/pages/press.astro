---
import { getCollection } from 'astro:content';

import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import MediaVideo from '../components/media/MediaVideo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPress = await getCollection('press');
const sortedPress = allPress.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Featured press for carousel
const featuredPress = sortedPress.filter((item) => item.data.featured).slice(0, 5);
const pressQuotes = featuredPress.map((item) => ({
  text: item.data.excerpt,
  publication: item.data.publication,
  author: item.data.author,
}));

// Helper to get image src
function getImageSrc(image: { src: string } | undefined): string | undefined {
  if (!image) return undefined;
  return image.src;
}
---

<BaseLayout title="Press - Davis Ponjuán" description="Press coverage and reviews">
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Press & Reviews</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Selected press coverage and critical reviews of performances throughout my career.
    </p>
  </header>

  <!-- Featured Quotes Carousel -->
  {
    pressQuotes.length > 0 && (
      <section class="py-8 md:py-10 bg-muted/30 -mx-6 md:-mx-10 lg:-mx-16 px-6 md:px-10 lg:px-16 mb-8 fade-in-up delay-1">
        <FeaturedCarousel quotes={pressQuotes} interval={7000} />
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- All Press Items -->
  <section class="fade-in-up delay-2">
    <h2 class="text-nav text-muted-foreground mb-4">All Reviews</h2>

    <div class="divide-y divide-border">
      {
        sortedPress.map(async (item, index) => {
          const { Content } = await item.render();
          const imageSrc = getImageSrc(item.data.image);
          const hasVideo = item.data.video;

          return (
            <article class={`group py-6 first:pt-0 fade-in-up delay-${Math.min(index + 2, 5)}`}>
              <div class="grid lg:grid-cols-12 gap-4 lg:gap-8">
                {/* Sidebar - Publication info & Media */}
                <div class="lg:col-span-3">
                  {/* Featured image for press item */}
                  {item.data.featured && imageSrc && (
                    <div class="mb-4 rounded-md overflow-hidden">
                      <img
                        src={imageSrc}
                        alt={item.data.title}
                        class="w-full aspect-video object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="font-semibold text-sm">{item.data.publication}</div>
                  {item.data.author && (
                    <div class="text-xs text-muted-foreground">{item.data.author}</div>
                  )}
                  <time
                    datetime={item.data.date.toISOString()}
                    class="text-nav text-muted-foreground block mt-1"
                  >
                    {item.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                  </time>
                  {item.data.featured && (
                    <span class="inline-block mt-2 px-1.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded">
                      Featured
                    </span>
                  )}
                </div>

                {/* Main content */}
                <div class="lg:col-span-9">
                  <h3 class="text-lg md:text-xl font-serif mb-3 group-hover:text-primary transition-colors duration-300">
                    {item.data.title}
                  </h3>

                  <blockquote class="text-base md:text-lg font-serif italic leading-relaxed text-foreground mb-3 pl-4 border-l-2 border-primary">
                    "{item.data.excerpt}"
                  </blockquote>

                  <div class="text-sm text-muted-foreground line-clamp-2">
                    <Content />
                  </div>

                  {/* Video embed for featured press */}
                  {item.data.featured && hasVideo && (
                    <div class="mt-4">
                      <MediaVideo video={item.data.video} />
                    </div>
                  )}

                  {item.data.url && (
                    <a
                      href={item.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 mt-3 text-sm text-primary hover:underline underline-offset-4 transition-all duration-300"
                    >
                      Read full article
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
