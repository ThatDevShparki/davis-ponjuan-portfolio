---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allPress = await getCollection('press');
const sortedPress = allPress.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Press - Davis Ponjuan" description="Press coverage and reviews">
  <h1 class="text-5xl mb-4">Press & Reviews</h1>

  <p class="text-lg leading-relaxed mb-12 text-gray-600">
    Selected press coverage and critical reviews of performances throughout my career.
  </p>

  <ul class="list-none p-0">
    {
      sortedPress.map(async (item) => {
        const { Content } = await item.render();
        return (
          <li class="mb-12 pb-12 border-b border-gray-200 last:border-b-0">
            <article>
              <h2 class="text-2xl mb-3">{item.data.title}</h2>
              <div class="text-gray-600 mb-4 text-[0.95rem]">
                <strong>{item.data.publication}</strong>
                {item.data.author && ` • ${item.data.author}`}
                {' • '}
                <time datetime={item.data.date.toISOString()}>
                  {item.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {item.data.url && (
                  <>
                    {' '}
                    •{' '}
                    <a
                      href={item.data.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#2d7a3e] no-underline hover:underline"
                    >
                      Read full article
                    </a>
                  </>
                )}
              </div>
              <blockquote class="text-xl italic my-6 pl-6 border-l-4 border-[#2d7a3e] leading-relaxed">
                {item.data.excerpt}
              </blockquote>
              <div class="leading-relaxed text-gray-600">
                <Content />
              </div>
            </article>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
