---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allPress = await getCollection('press');
const sortedPress = allPress.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Press - Davis Ponjuan" description="Press coverage and reviews">
  <header class="section fade-in">
    <h1 class="mb-6">Press & Reviews</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      Selected press coverage and critical reviews of performances throughout my career.
    </p>
  </header>

  <hr class="divider-dashed" />

  <ul class="list-none p-0">
    {
      sortedPress.map(async (item, index) => {
        const { Content } = await item.render();
        return (
          <li class={`section fade-in-up delay-${Math.min(index + 1, 5)}`}>
            <article>
              <div class="metadata mb-4 flex flex-wrap gap-x-1">
                <strong class="text-foreground">{item.data.publication}</strong>
                {item.data.author && (
                  <>
                    <span class="metadata-separator" />
                    <span>{item.data.author}</span>
                  </>
                )}
                <span class="metadata-separator" />
                <time datetime={item.data.date.toISOString()}>
                  {item.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="text-2xl md:text-3xl mb-6">{item.data.title}</h2>
              <blockquote class="press-quote-lg">{item.data.excerpt}</blockquote>
              <div class="leading-relaxed text-muted-foreground mt-6 max-w-3xl">
                <Content />
              </div>
              {item.data.url && (
                <div class="mt-6">
                  <a
                    href={item.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:underline underline-offset-4 transition-all duration-300 no-external-icon"
                  >
                    Read full article ↗
                  </a>
                </div>
              )}
            </article>
            <hr class="divider-dashed-sm mt-12" />
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
