---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allWorkshops = await getCollection('workshops');

// Group by year
const workshopsByYear = allWorkshops.reduce(
  (acc, workshop) => {
    const year = workshop.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(workshop);
    return acc;
  },
  {} as Record<number, typeof allWorkshops>
);

// Sort workshops within each year
Object.keys(workshopsByYear).forEach((year) => {
  workshopsByYear[Number(year)].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
});

const years = Object.keys(workshopsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Workshops & Masterclasses - Davis Ponjuan"
  description="Educational activities and teaching engagements"
>
  <h1 class="text-5xl mb-12">Workshops & Masterclasses</h1>

  {
    years.map((year) => (
      <section class="mb-16">
        <h2 class="text-3xl font-bold mb-8 text-[#2d7a3e] border-b-2 border-[#2d7a3e] pb-2">
          {year}
        </h2>
        <div class="grid gap-8">
          {workshopsByYear[year].map(async (workshop) => {
            const { Content } = await workshop.render();
            return (
              <article class="border border-gray-300 rounded-lg p-8 bg-gray-50">
                <div class="flex items-start gap-4 mb-6 pb-4 border-b border-gray-300">
                  <h3 class="text-2xl m-0 flex-1">{workshop.data.title}</h3>
                  <span class="inline-block bg-[#2d7a3e] text-white py-1 px-3 text-xs rounded font-semibold uppercase tracking-wide flex-shrink-0">
                    {workshop.data.type}
                  </span>
                </div>

                <div class="mb-6">
                  <div class="mb-3 text-gray-800">
                    <strong class="text-gray-600 mr-2">Institution:</strong>{' '}
                    {workshop.data.institution}
                  </div>
                  <div class="mb-3 text-gray-800">
                    <strong class="text-gray-600 mr-2">Location:</strong> {workshop.data.location}
                  </div>
                  <div class="mb-3 text-gray-800">
                    <strong class="text-gray-600 mr-2">Date:</strong>{' '}
                    {workshop.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                    {workshop.data.endDate &&
                      workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                      ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                        month: 'long',
                        day: 'numeric',
                      })}`}
                  </div>
                  {workshop.data.topic && (
                    <div class="mb-3 text-gray-800 italic text-gray-600">
                      <strong class="text-gray-600 mr-2">Topic:</strong> {workshop.data.topic}
                    </div>
                  )}
                  {workshop.data.participants && (
                    <div class="mb-3 text-gray-800">
                      <strong class="text-gray-600 mr-2">Participants:</strong>{' '}
                      {workshop.data.participants}
                    </div>
                  )}
                </div>

                <div class="leading-relaxed [&_p]:mb-4 [&_p:last-child]:mb-0">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>
