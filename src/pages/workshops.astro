---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import BaseLayout from '../layouts/BaseLayout.astro';

const allWorkshops = await getCollection('workshops');

// Group by year
const workshopsByYear = allWorkshops.reduce(
  (acc, workshop) => {
    const year = workshop.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(workshop);
    return acc;
  },
  {} as Record<number, typeof allWorkshops>
);

// Sort workshops within each year
Object.keys(workshopsByYear).forEach((year) => {
  workshopsByYear[Number(year)].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
});

const years = Object.keys(workshopsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Workshops & Masterclasses - Davis Ponjuan"
  description="Educational activities and teaching engagements"
>
  <header class="mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Workshops & Masterclasses</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Educational activities and teaching engagements at institutions worldwide.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    years.map((year, yearIndex) => (
      <section class={`mb-10 fade-in-up delay-${Math.min(yearIndex + 1, 5)}`}>
        <h2 class="text-2xl font-serif text-primary mb-4 pb-1 border-b border-primary inline-block">
          {year}
        </h2>
        <div class="space-y-4">
          {workshopsByYear[year].map(async (workshop) => {
            const { Content } = await workshop.render();
            return (
              <article class="border border-border rounded-md p-4 bg-card">
                <div class="flex items-start gap-3 mb-3">
                  <h3 class="text-lg font-serif flex-1">{workshop.data.title}</h3>
                  <Badge variant="featured" className="flex-shrink-0 text-[10px]">
                    {workshop.data.type}
                  </Badge>
                </div>

                <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                  <div>
                    <span class="text-muted-foreground">Institution:</span>{' '}
                    {workshop.data.institution}
                  </div>
                  <div>
                    <span class="text-muted-foreground">Location:</span> {workshop.data.location}
                  </div>
                  <div>
                    <span class="text-muted-foreground">Date:</span>{' '}
                    {workshop.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                      day: 'numeric',
                    })}
                    {workshop.data.endDate &&
                      workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                      ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}`}
                  </div>
                  {workshop.data.participants && (
                    <div>
                      <span class="text-muted-foreground">Participants:</span>{' '}
                      {workshop.data.participants}
                    </div>
                  )}
                </div>

                {workshop.data.topic && (
                  <div class="text-sm font-serif italic text-muted-foreground mb-3">
                    {workshop.data.topic}
                  </div>
                )}

                <div class="text-sm text-muted-foreground [&_p]:mb-2 [&_p:last-child]:mb-0">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>
