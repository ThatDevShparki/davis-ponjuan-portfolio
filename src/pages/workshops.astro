---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import BaseLayout from '../layouts/BaseLayout.astro';

const allWorkshops = await getCollection('workshops');

// Group by year
const workshopsByYear = allWorkshops.reduce(
  (acc, workshop) => {
    const year = workshop.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(workshop);
    return acc;
  },
  {} as Record<number, typeof allWorkshops>
);

// Sort workshops within each year
Object.keys(workshopsByYear).forEach((year) => {
  workshopsByYear[Number(year)].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
});

const years = Object.keys(workshopsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Workshops & Masterclasses - Davis Ponjuan"
  description="Educational activities and teaching engagements"
>
  <header class="section fade-in">
    <h1 class="mb-6">Workshops & Masterclasses</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      Educational activities and teaching engagements at institutions worldwide.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    years.map((year, yearIndex) => (
      <section class={`section fade-in-up delay-${Math.min(yearIndex + 1, 5)}`}>
        <h2 class="text-4xl font-serif text-primary border-b-2 border-primary pb-2 mb-8 inline-block">
          {year}
        </h2>
        <div class="grid gap-8">
          {workshopsByYear[year].map(async (workshop) => {
            const { Content } = await workshop.render();
            return (
              <article class="border border-border rounded-lg p-8 bg-card">
                <div class="flex items-start gap-4 mb-6 pb-4 border-b border-border">
                  <h3 class="text-2xl font-serif m-0 flex-1">{workshop.data.title}</h3>
                  <Badge variant="featured" className="flex-shrink-0">
                    {workshop.data.type}
                  </Badge>
                </div>

                <div class="mb-6 space-y-3">
                  <div>
                    <strong class="text-muted-foreground mr-2">Institution:</strong>{' '}
                    {workshop.data.institution}
                  </div>
                  <div>
                    <strong class="text-muted-foreground mr-2">Location:</strong>{' '}
                    {workshop.data.location}
                  </div>
                  <div>
                    <strong class="text-muted-foreground mr-2">Date:</strong>{' '}
                    {workshop.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                    {workshop.data.endDate &&
                      workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                      ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                        month: 'long',
                        day: 'numeric',
                      })}`}
                  </div>
                  {workshop.data.topic && (
                    <div class="italic">
                      <strong class="text-muted-foreground mr-2 not-italic">Topic:</strong>{' '}
                      {workshop.data.topic}
                    </div>
                  )}
                  {workshop.data.participants && (
                    <div>
                      <strong class="text-muted-foreground mr-2">Participants:</strong>{' '}
                      {workshop.data.participants}
                    </div>
                  )}
                </div>

                <div class="leading-relaxed text-muted-foreground [&_p]:mb-4 [&_p:last-child]:mb-0">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>
