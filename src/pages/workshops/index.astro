---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import BaseLayout from '../../layouts/BaseLayout.astro';

const allWorkshops = await getCollection('workshops');

// Group by year
const workshopsByYear = allWorkshops.reduce(
  (acc, workshop) => {
    const year = workshop.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(workshop);
    return acc;
  },
  {} as Record<number, typeof allWorkshops>
);

// Sort workshops within each year
Object.keys(workshopsByYear).forEach((year) => {
  workshopsByYear[Number(year)].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
});

const years = Object.keys(workshopsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Workshops & Masterclasses - Davis Ponjuán"
  description="Educational activities and teaching engagements"
>
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Workshops & Masterclasses</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Educational activities and teaching engagements at institutions worldwide.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    years.map((year, yearIndex) => (
      <section class={`mb-10 fade-in-up delay-${Math.min(yearIndex + 1, 5)}`}>
        <h2 class="text-2xl font-serif text-primary mb-4 pb-1 border-b border-primary inline-block">
          {year}
        </h2>
        <div class="space-y-6">
          {workshopsByYear[year].map(async (workshop) => {
            const { Content } = await workshop.render();
            const hasGallery = workshop.data.gallery && workshop.data.gallery.length > 0;
            const heroImage = hasGallery ? workshop.data.gallery![0] : null;

            return (
              <article class="group border border-border rounded-md overflow-hidden bg-card hover:border-primary transition-colors duration-300">
                {/* Hero image from gallery */}
                {heroImage && (
                  <a
                    href={`/workshops/${workshop.id}`}
                    class="block relative h-48 md:h-56 overflow-hidden"
                  >
                    <img
                      src={heroImage.src}
                      alt={heroImage.alt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-card/60 to-transparent" />
                  </a>
                )}

                <div class="p-4 md:p-5">
                  {/* Header */}
                  <div class="flex items-start gap-3 mb-3">
                    <h3 class="text-lg font-serif flex-1 group-hover:text-primary transition-colors duration-300">
                      <a href={`/workshops/${workshop.id}`}>{workshop.data.title}</a>
                    </h3>
                    <Badge variant="featured" className="flex-shrink-0">
                      {workshop.data.type}
                    </Badge>
                  </div>

                  {/* Details */}
                  <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                    <div>
                      <span class="text-muted-foreground">Institution:</span>{' '}
                      {workshop.data.institution}
                    </div>
                    <div>
                      <span class="text-muted-foreground">Location:</span> {workshop.data.location}
                    </div>
                    <div>
                      <span class="text-muted-foreground">Date:</span>{' '}
                      {workshop.data.date.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                        day: 'numeric',
                      })}
                      {workshop.data.endDate &&
                        workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                        ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                          month: 'short',
                          day: 'numeric',
                        })}`}
                    </div>
                    {workshop.data.participants && (
                      <div>
                        <span class="text-muted-foreground">Participants:</span>{' '}
                        {workshop.data.participants}
                      </div>
                    )}
                  </div>

                  {workshop.data.topic && (
                    <div class="text-sm font-serif italic text-muted-foreground mb-3">
                      {workshop.data.topic}
                    </div>
                  )}

                  <div class="text-sm text-muted-foreground [&_p]:mb-2 [&_p:last-child]:mb-0">
                    <Content />
                  </div>

                  {/* View details link */}
                  <a
                    href={`/workshops/${workshop.id}`}
                    class="inline-flex items-center gap-1 mt-4 text-sm text-primary hover:underline underline-offset-4 transition-all duration-300"
                  >
                    View details
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    ))
  }
</BaseLayout>
