---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import MediaGallery from '../../components/media/MediaGallery.astro';
import MediaLinks from '../../components/media/MediaLinks.astro';
import MediaVideo from '../../components/media/MediaVideo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const workshops = await getCollection('workshops');
  return workshops.map((workshop) => ({
    params: { id: workshop.id },
    props: { workshop },
  }));
}) satisfies GetStaticPaths;

const { workshop } = Astro.props;

// Render markdown content
let Content;
let renderError = false;
try {
  const rendered = await workshop.render();
  Content = rendered.Content;
} catch (error) {
  console.error(`Failed to render workshop: ${workshop.id}`, error);
  renderError = true;
}

// Check for media
const hasGallery = workshop.data.gallery && workshop.data.gallery.length > 0;
const hasVideos = workshop.data.videos && workshop.data.videos.length > 0;
const hasLinks = workshop.data.externalLinks && workshop.data.externalLinks.length > 0;
const hasMedia = hasGallery || hasVideos || hasLinks;

// Get hero image
const heroImage = hasGallery ? workshop.data.gallery![0] : null;
---

<BaseLayout
  title={`${workshop.data.title} - Davis Ponjuán`}
  description={`${workshop.data.type} at ${workshop.data.institution}`}
>
  {/* Hero Image - Full Width, extends behind navbar */}
  {
    heroImage && (
      <div
        class="relative mb-10 fade-in -mt-24 md:-mt-28"
        style="width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);"
      >
        <div class="relative h-[35vh] md:h-[40vh] lg:h-[45vh] overflow-hidden">
          <img
            src={heroImage.src}
            alt={heroImage.alt}
            class="w-full h-full object-cover object-[center_30%]"
            loading="eager"
          />
          <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background to-transparent" />
        </div>
      </div>
    )
  }

  <article class="max-w-4xl fade-in">
    {/* Header */}
    <header class="mb-8 pb-6 border-b border-border fade-in-up delay-1">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <Badge variant="featured">
          {workshop.data.type}
        </Badge>
        <span class="text-nav text-muted-foreground">
          {
            workshop.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
          {
            workshop.data.endDate &&
              workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
              ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
              })}`
          }
        </span>
      </div>

      <h1 class="text-3xl md:text-4xl font-serif mb-4">{workshop.data.title}</h1>

      {
        workshop.data.topic && (
          <p class="text-lg font-serif italic text-muted-foreground mb-4">{workshop.data.topic}</p>
        )
      }

      <div class="flex flex-wrap gap-4 text-sm text-muted-foreground">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
            ></path>
          </svg>
          {workshop.data.institution}
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          {workshop.data.location}
        </span>
        {
          workshop.data.participants && (
            <span class="flex items-center gap-1.5">
              <svg
                class="w-4 h-4 text-primary"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                />
              </svg>
              {workshop.data.participants}
            </span>
          )
        }
      </div>
    </header>

    {/* Content */}
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-12">
      <div class="lg:col-span-8">
        {
          !renderError && (
            <section class="prose prose-neutral dark:prose-invert max-w-none fade-in-up delay-2">
              <Content />
            </section>
          )
        }
        {
          renderError && (
            <p class="text-muted-foreground italic">
              Details are currently unavailable for this workshop.
            </p>
          )
        }
      </div>

      {/* Sidebar - External Links */}
      {
        hasLinks && (
          <aside class="lg:col-span-4 lg:border-l lg:border-border lg:pl-8 fade-in-up delay-3">
            <h2 class="text-nav text-muted-foreground mb-4">Resources</h2>
            <MediaLinks links={workshop.data.externalLinks!} variant="list" />
          </aside>
        )
      }
    </div>

    {/* Media Section */}
    {
      hasMedia && (
        <>
          <hr class="divider-dashed" />

          <section class="fade-in-up delay-4">
            <h2 class="text-2xl font-serif mb-6">Media</h2>

            {/* Videos */}
            {hasVideos && (
              <div class="mb-8">
                <h3 class="text-nav text-muted-foreground mb-4">Videos</h3>
                <div class="grid md:grid-cols-2 gap-6">
                  {workshop.data.videos!.map((video) => (
                    <MediaVideo video={video} />
                  ))}
                </div>
              </div>
            )}

            {/* Gallery */}
            {hasGallery && (
              <div class="mb-8">
                <h3 class="text-nav text-muted-foreground mb-4">Gallery</h3>
                <MediaGallery images={workshop.data.gallery!} columns={3} />
              </div>
            )}
          </section>
        </>
      )
    }

    <nav class="mt-12 pt-6 border-t border-border">
      <a
        href="/workshops"
        class="inline-flex items-center gap-2 text-primary hover:underline underline-offset-4 transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"
          ></path>
        </svg>
        Back to all workshops
      </a>
    </nav>
  </article>
</BaseLayout>
