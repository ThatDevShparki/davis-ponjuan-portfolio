---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const sortedOrgs = allOrganizations.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const sortedAwards = allAwards.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allRecordings = await getCollection('recordings');
const sortedRecordings = allRecordings.sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime()
);

const allWorkshops = await getCollection('workshops');
const sortedWorkshops = allWorkshops.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="CV - Davis Ponjuan" description="Curriculum Vitae">
  <h1 class="text-5xl mb-12">Curriculum Vitae</h1>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Education</h2>
    <div class="border-l-2 border-[#2d7a3e] pl-8">
      {
        sortedEducation.map((edu) => (
          <div class="mb-10 relative before:content-[''] before:absolute before:left-[-2.375rem] before:top-1.5 before:w-3 before:h-3 before:bg-[#2d7a3e] before:rounded-full">
            <div class="text-sm font-semibold text-gray-600 mb-2">
              {edu.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
              })}
              {edu.data.endDate &&
                ` – ${edu.data.endDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                })}`}
            </div>
            <div>
              <h3 class="text-xl mb-1">{edu.data.degree}</h3>
              <div class="text-lg text-gray-800">
                {edu.data.field} • {edu.data.institution}
              </div>
              <div class="text-gray-600 mt-1">{edu.data.location}</div>
              {edu.data.honors && (
                <div class="text-[#2d7a3e] italic mt-2 text-[0.95rem]">{edu.data.honors}</div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Professional Experience</h2>
    <div class="border-l-2 border-[#2d7a3e] pl-8">
      {
        sortedOrgs.map((org) => (
          <div class="mb-10 relative before:content-[''] before:absolute before:left-[-2.375rem] before:top-1.5 before:w-3 before:h-3 before:bg-[#2d7a3e] before:rounded-full">
            <div class="text-sm font-semibold text-gray-600 mb-2">
              {org.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
              {' – '}
              {org.data.endDate
                ? org.data.endDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                  })
                : 'Present'}
            </div>
            <div>
              <h3 class="text-xl mb-1">{org.data.role}</h3>
              <div class="text-lg text-gray-800">{org.data.name}</div>
              <div class="text-gray-600 mt-1">{org.data.location}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Awards & Honors</h2>
    <ul class="list-none p-0">
      {
        sortedAwards.map((award) => (
          <li class="mb-6 pb-6 border-b border-gray-200 last:border-b-0">
            <strong>{award.data.title}</strong>
            <div class="text-gray-600 text-[0.95rem] mt-1">
              {award.data.organization} •{' '}
              {award.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
              })}
              {award.data.location && ` • ${award.data.location}`}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Recordings</h2>
    <ul class="list-none p-0">
      {
        sortedRecordings.map((recording) => (
          <li class="mb-6 pb-6 border-b border-gray-200 last:border-b-0">
            <strong>{recording.data.title}</strong>
            <div class="text-gray-600 text-[0.95rem] mt-1">
              {recording.data.orchestra} • {recording.data.label} •{' '}
              {recording.data.releaseDate.toLocaleDateString('en-US', {
                year: 'numeric',
              })}
            </div>
            <div class="text-[#2d7a3e] text-[0.85rem] mt-1 font-medium">
              {recording.data.format.join(', ')}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Masterclasses & Workshops</h2>
    <ul class="list-none p-0">
      {
        sortedWorkshops.map((workshop) => (
          <li class="mb-6 pb-6 border-b border-gray-200 last:border-b-0">
            <strong>{workshop.data.title}</strong>
            <div class="text-gray-600 text-[0.95rem] mt-1">
              {workshop.data.institution} • {workshop.data.location} •{' '}
              {workshop.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
              })}
              {workshop.data.endDate &&
                workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                })}`}
            </div>
            {workshop.data.topic && (
              <div class="text-gray-600 text-sm italic mt-2">{workshop.data.topic}</div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="mt-12 pt-8 border-t-2 border-gray-300">
    <button
      class="inline-block py-3 px-6 bg-[#2d7a3e] text-white border-none rounded cursor-pointer text-base font-[inherit] hover:bg-[#246330]"
      onclick="window.print(); return false;">Print CV as PDF</button
    >
  </nav>
</BaseLayout>

<style>
  @media print {
    /* Hide navigation and actions */
    nav,
    .cv-actions,
    header,
    footer {
      display: none !important;
    }

    /* Reset page margins */
    @page {
      margin: 0.5in;
    }

    body {
      font-size: 9pt;
      line-height: 1.3;
    }

    /* Compact heading sizes */
    h1 {
      font-size: 18pt;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 11pt;
      margin-bottom: 0.3rem;
      margin-top: 0.5rem;
      padding-bottom: 0.15rem;
      border-bottom: 1px solid #333;
      page-break-after: avoid;
    }

    h3 {
      font-size: 10pt;
      margin-bottom: 0.1rem;
    }

    /* Compact sections */
    section {
      margin-bottom: 0.75rem;
    }

    /* Prevent breaks right after headings */
    h1,
    h2,
    h3 {
      page-break-after: avoid;
    }

    /* Keep timeline and lists together when possible */
    .timeline,
    .awards-list,
    .recordings-list,
    .workshops-list {
      page-break-inside: auto;
    }

    /* Compact timeline */
    .border-l-2 {
      border-left: 1px solid #333;
      padding-left: 0.75rem;
    }

    .mb-10 {
      margin-bottom: 0.4rem;
      page-break-inside: avoid;
    }

    .mb-10::before {
      width: 0.35rem;
      height: 0.35rem;
      left: -0.93rem;
      top: 0.2rem;
    }

    .text-sm {
      font-size: 8pt;
    }

    .text-lg {
      font-size: 9pt;
    }

    .text-gray-600,
    .text-\[\#2d7a3e\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Compact lists */
    .list-none {
      padding: 0;
    }

    .mb-6 {
      margin-bottom: 0.3rem;
      padding-bottom: 0.3rem;
      border-bottom: none;
      page-break-inside: avoid;
    }

    .text-\[0\.95rem\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    .text-\[0\.85rem\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Ensure compact line heights throughout */
    p,
    li,
    div {
      line-height: 1.3;
    }

    /* Remove background colors */
    * {
      background: white !important;
      color: black !important;
    }

    /* Preserve important colors */
    h2 {
      border-bottom-color: black !important;
    }
  }
</style>
