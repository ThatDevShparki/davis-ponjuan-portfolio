---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const sortedOrgs = allOrganizations.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const sortedAwards = allAwards.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allRecordings = await getCollection('recordings');
const sortedRecordings = allRecordings.sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime()
);

const allWorkshops = await getCollection('workshops');
const sortedWorkshops = allWorkshops.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="CV - Davis Ponjuán" description="Curriculum Vitae">
  <header class="mb-10 md:mb-14 fade-in">
    <h1 class="text-5xl md:text-6xl lg:text-7xl tracking-tight mb-4 md:mb-5">Curriculum Vitae</h1>
    <p class="text-lg md:text-xl text-muted-foreground max-w-2xl leading-relaxed">
      Education, professional experience, awards, and discography.
    </p>
  </header>

  <hr class="divider-dashed" />

  <section class="mb-10 fade-in-up delay-1">
    <h2 class="text-nav text-muted-foreground mb-4">Education</h2>
    <ul class="divide-y divide-border">
      {
        sortedEducation.map((edu) => (
          <li class="py-2.5 first:pt-0">
            <div class="font-serif">{edu.data.degree}</div>
            <div class="text-sm">
              {edu.data.field} · {edu.data.institution}
            </div>
            <div class="text-xs text-muted-foreground mt-0.5 flex flex-wrap gap-x-2">
              <span>
                {edu.data.startDate.toLocaleDateString('en-US', { year: 'numeric' })}
                {edu.data.endDate &&
                  ` – ${edu.data.endDate.toLocaleDateString('en-US', { year: 'numeric' })}`}
              </span>
              <span>·</span>
              <span>{edu.data.location}</span>
            </div>
            {edu.data.honors && (
              <div class="text-xs text-primary italic mt-1">{edu.data.honors}</div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10 fade-in-up delay-2">
    <h2 class="text-nav text-muted-foreground mb-4">Professional Experience</h2>
    <ul class="divide-y divide-border">
      {
        sortedOrgs.map((org) => (
          <li class="py-2.5 first:pt-0">
            <div class="font-serif">{org.data.role}</div>
            <div class="text-sm">{org.data.name}</div>
            <div class="text-xs text-muted-foreground mt-0.5 flex flex-wrap gap-x-2">
              <span>
                {org.data.startDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
                {' – '}
                {org.data.endDate
                  ? org.data.endDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })
                  : 'Present'}
              </span>
              <span>·</span>
              <span>{org.data.location}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10 fade-in-up delay-3">
    <h2 class="text-nav text-muted-foreground mb-4">Awards & Honors</h2>
    <ul class="divide-y divide-border">
      {
        sortedAwards.map((award) => (
          <li class="py-2.5 first:pt-0">
            <div class="font-serif">{award.data.title}</div>
            <div class="text-xs text-muted-foreground mt-0.5 flex flex-wrap gap-x-2">
              <span>{award.data.organization}</span>
              <span>·</span>
              <span>
                {award.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </span>
              {award.data.location && (
                <>
                  <span>·</span>
                  <span>{award.data.location}</span>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10 fade-in-up delay-4">
    <h2 class="text-nav text-muted-foreground mb-4">Recordings</h2>
    <ul class="divide-y divide-border">
      {
        sortedRecordings.map((recording) => (
          <li class="py-2.5 first:pt-0">
            <div class="font-serif">{recording.data.title}</div>
            <div class="text-xs text-muted-foreground mt-0.5 flex flex-wrap gap-x-2">
              <span>{recording.data.orchestra}</span>
              <span>·</span>
              <span>{recording.data.label}</span>
              <span>·</span>
              <span>
                {recording.data.releaseDate.toLocaleDateString('en-US', { year: 'numeric' })}
              </span>
              <span>·</span>
              <span class="text-primary">{recording.data.format.join(', ')}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10 fade-in-up delay-5">
    <h2 class="text-nav text-muted-foreground mb-4">Masterclasses & Workshops</h2>
    <ul class="divide-y divide-border">
      {
        sortedWorkshops.map((workshop) => (
          <li class="py-2.5 first:pt-0">
            <div class="font-serif">{workshop.data.title}</div>
            <div class="text-xs text-muted-foreground mt-0.5 flex flex-wrap gap-x-2">
              <span>{workshop.data.institution}</span>
              <span>·</span>
              <span>{workshop.data.location}</span>
              <span>·</span>
              <span>
                {workshop.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </span>
            </div>
            {workshop.data.topic && (
              <div class="text-xs text-muted-foreground italic mt-1">{workshop.data.topic}</div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="divider-dashed" />

  <nav class="fade-in-up flex flex-wrap items-center justify-between gap-3">
    <a
      href="/contact"
      class="inline-flex items-center justify-center h-10 px-4 py-2 rounded-md text-sm font-medium bg-primary text-primary-foreground hover:bg-primary-hover active:scale-[0.98] transition-all duration-300"
    >
      Request Full CV
    </a>
    <button
      type="button"
      id="print-btn"
      class="inline-flex items-center justify-center h-10 px-4 py-2 rounded-md text-sm font-medium text-foreground hover:bg-muted/50 transition-all duration-300"
    >
      Print as PDF
    </button>
  </nav>

  <script>
    document.getElementById('print-btn')?.addEventListener('click', () => {
      window.print();
    });
  </script>
</BaseLayout>

<style>
  @media print {
    nav,
    header,
    footer {
      display: none !important;
    }

    @page {
      margin: 0.5in;
    }

    body {
      font-size: 9pt;
      line-height: 1.3;
    }

    h1 {
      font-size: 18pt;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 11pt;
      margin-bottom: 0.3rem;
      margin-top: 0.5rem;
      padding-bottom: 0.15rem;
      border-bottom: 1px solid #333;
      page-break-after: avoid;
    }

    h3 {
      font-size: 10pt;
      margin-bottom: 0.1rem;
    }

    section {
      margin-bottom: 0.75rem;
    }

    li {
      page-break-inside: avoid;
    }

    p,
    li,
    div {
      line-height: 1.3;
    }

    * {
      background: white !important;
      color: black !important;
    }
  }
</style>
