---
import { getCollection } from 'astro:content';

import { Button } from '@/components/ui/button';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const sortedOrgs = allOrganizations.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const sortedAwards = allAwards.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allRecordings = await getCollection('recordings');
const sortedRecordings = allRecordings.sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime()
);

const allWorkshops = await getCollection('workshops');
const sortedWorkshops = allWorkshops.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="CV - Davis Ponjuan" description="Curriculum Vitae">
  <header class="section fade-in">
    <h1 class="mb-6">Curriculum Vitae</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      A comprehensive overview of education, professional experience, and achievements.
    </p>
  </header>

  <hr class="divider-dashed" />

  <section class="section fade-in-up delay-1">
    <h2 class="section-heading">Education</h2>
    <div class="border-l-2 border-primary pl-8">
      {
        sortedEducation.map((edu) => (
          <div class="mb-10 relative before:content-[''] before:absolute before:left-[-2.375rem] before:top-1.5 before:w-3 before:h-3 before:bg-primary before:rounded-full">
            <div class="metadata mb-2">
              {edu.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
              })}
              {edu.data.endDate &&
                ` – ${edu.data.endDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                })}`}
            </div>
            <div>
              <h3 class="text-xl mb-1 font-serif">{edu.data.degree}</h3>
              <div class="text-lg">
                {edu.data.field} • {edu.data.institution}
              </div>
              <div class="text-muted-foreground mt-1">{edu.data.location}</div>
              {edu.data.honors && <div class="text-primary italic mt-2">{edu.data.honors}</div>}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section fade-in-up delay-2">
    <h2 class="section-heading">Professional Experience</h2>
    <div class="border-l-2 border-primary pl-8">
      {
        sortedOrgs.map((org) => (
          <div class="mb-10 relative before:content-[''] before:absolute before:left-[-2.375rem] before:top-1.5 before:w-3 before:h-3 before:bg-primary before:rounded-full">
            <div class="metadata mb-2">
              {org.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
              {' – '}
              {org.data.endDate
                ? org.data.endDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                  })
                : 'Present'}
            </div>
            <div>
              <h3 class="text-xl mb-1 font-serif">{org.data.role}</h3>
              <div class="text-lg">{org.data.name}</div>
              <div class="text-muted-foreground mt-1">{org.data.location}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section fade-in-up delay-3">
    <h2 class="section-heading">Awards & Honors</h2>
    <ul class="list-none p-0">
      {
        sortedAwards.map((award) => (
          <li class="list-divider py-4">
            <strong class="font-serif text-lg">{award.data.title}</strong>
            <div class="metadata mt-1 flex flex-wrap gap-x-1">
              <span>{award.data.organization}</span>
              <span class="metadata-separator" />
              <span>
                {award.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
              </span>
              {award.data.location && (
                <>
                  <span class="metadata-separator" />
                  <span>{award.data.location}</span>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section fade-in-up delay-4">
    <h2 class="section-heading">Recordings</h2>
    <ul class="list-none p-0">
      {
        sortedRecordings.map((recording) => (
          <li class="list-divider py-4">
            <strong class="font-serif text-lg">{recording.data.title}</strong>
            <div class="metadata mt-1 flex flex-wrap gap-x-1">
              <span>{recording.data.orchestra}</span>
              <span class="metadata-separator" />
              <span>{recording.data.label}</span>
              <span class="metadata-separator" />
              <span>
                {recording.data.releaseDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                })}
              </span>
            </div>
            <div class="text-primary text-sm mt-1 font-medium">
              {recording.data.format.join(', ')}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section fade-in-up delay-5">
    <h2 class="section-heading">Masterclasses & Workshops</h2>
    <ul class="list-none p-0">
      {
        sortedWorkshops.map((workshop) => (
          <li class="list-divider py-4">
            <strong class="font-serif text-lg">{workshop.data.title}</strong>
            <div class="metadata mt-1 flex flex-wrap gap-x-1">
              <span>{workshop.data.institution}</span>
              <span class="metadata-separator" />
              <span>{workshop.data.location}</span>
              <span class="metadata-separator" />
              <span>
                {workshop.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
                {workshop.data.endDate &&
                  workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                  ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                    month: 'long',
                    day: 'numeric',
                  })}`}
              </span>
            </div>
            {workshop.data.topic && (
              <div class="text-muted-foreground text-sm italic mt-2">{workshop.data.topic}</div>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="divider-dashed" />

  <nav class="fade-in-up">
    <Button size="xl" onclick="window.print(); return false;"> Print CV as PDF </Button>
  </nav>
</BaseLayout>

<style>
  @media print {
    /* Hide navigation and actions */
    nav,
    .cv-actions,
    header,
    footer {
      display: none !important;
    }

    /* Reset page margins */
    @page {
      margin: 0.5in;
    }

    body {
      font-size: 9pt;
      line-height: 1.3;
    }

    /* Compact heading sizes */
    h1 {
      font-size: 18pt;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 11pt;
      margin-bottom: 0.3rem;
      margin-top: 0.5rem;
      padding-bottom: 0.15rem;
      border-bottom: 1px solid #333;
      page-break-after: avoid;
    }

    h3 {
      font-size: 10pt;
      margin-bottom: 0.1rem;
    }

    /* Compact sections */
    section {
      margin-bottom: 0.75rem;
    }

    /* Prevent breaks right after headings */
    h1,
    h2,
    h3 {
      page-break-after: avoid;
    }

    /* Keep timeline and lists together when possible */
    .timeline,
    .awards-list,
    .recordings-list,
    .workshops-list {
      page-break-inside: auto;
    }

    /* Compact timeline */
    .border-l-2 {
      border-left: 1px solid #333;
      padding-left: 0.75rem;
    }

    .mb-10 {
      margin-bottom: 0.4rem;
      page-break-inside: avoid;
    }

    .mb-10::before {
      width: 0.35rem;
      height: 0.35rem;
      left: -0.93rem;
      top: 0.2rem;
    }

    .text-sm {
      font-size: 8pt;
    }

    .text-lg {
      font-size: 9pt;
    }

    .text-gray-600,
    .text-\[\#2d7a3e\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Compact lists */
    .list-none {
      padding: 0;
    }

    .mb-6 {
      margin-bottom: 0.3rem;
      padding-bottom: 0.3rem;
      border-bottom: none;
      page-break-inside: avoid;
    }

    .text-\[0\.95rem\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    .text-\[0\.85rem\] {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Ensure compact line heights throughout */
    p,
    li,
    div {
      line-height: 1.3;
    }

    /* Remove background colors */
    * {
      background: white !important;
      color: black !important;
    }

    /* Preserve important colors */
    h2 {
      border-bottom-color: black !important;
    }
  }
</style>
