---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const sortedOrgs = allOrganizations.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const sortedAwards = allAwards.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allRecordings = await getCollection('recordings');
const sortedRecordings = allRecordings.sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime()
);

const allWorkshops = await getCollection('workshops');
const sortedWorkshops = allWorkshops.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="CV - Davis Ponjuan" description="Curriculum Vitae">
  <h1>Curriculum Vitae</h1>

  <section>
    <h2>Education</h2>
    <div class="timeline">
      {
        sortedEducation.map((edu) => (
          <div class="timeline-item">
            <div class="timeline-date">
              {edu.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
              })}
              {edu.data.endDate &&
                ` – ${edu.data.endDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                })}`}
            </div>
            <div class="timeline-content">
              <h3>{edu.data.degree}</h3>
              <div class="org-name">
                {edu.data.field} • {edu.data.institution}
              </div>
              <div class="org-location">{edu.data.location}</div>
              {edu.data.honors && <div class="honors">{edu.data.honors}</div>}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Professional Experience</h2>
    <div class="timeline">
      {
        sortedOrgs.map((org) => (
          <div class="timeline-item">
            <div class="timeline-date">
              {org.data.startDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
              {' – '}
              {org.data.endDate
                ? org.data.endDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                  })
                : 'Present'}
            </div>
            <div class="timeline-content">
              <h3>{org.data.role}</h3>
              <div class="org-name">{org.data.name}</div>
              <div class="org-location">{org.data.location}</div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>Awards & Honors</h2>
    <ul class="awards-list">
      {
        sortedAwards.map((award) => (
          <li>
            <strong>{award.data.title}</strong>
            <div class="award-meta">
              {award.data.organization} •{' '}
              {award.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
              })}
              {award.data.location && ` • ${award.data.location}`}
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Recordings</h2>
    <ul class="recordings-list">
      {
        sortedRecordings.map((recording) => (
          <li>
            <strong>{recording.data.title}</strong>
            <div class="recording-meta">
              {recording.data.orchestra} • {recording.data.label} •{' '}
              {recording.data.releaseDate.toLocaleDateString('en-US', {
                year: 'numeric',
              })}
            </div>
            <div class="recording-format">{recording.data.format.join(', ')}</div>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <h2>Masterclasses & Workshops</h2>
    <ul class="workshops-list">
      {
        sortedWorkshops.map((workshop) => (
          <li>
            <strong>{workshop.data.title}</strong>
            <div class="workshop-meta">
              {workshop.data.institution} • {workshop.data.location} •{' '}
              {workshop.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
              })}
              {workshop.data.endDate &&
                workshop.data.endDate.getTime() !== workshop.data.date.getTime() &&
                ` – ${workshop.data.endDate.toLocaleDateString('en-US', {
                  month: 'long',
                  day: 'numeric',
                })}`}
            </div>
            {workshop.data.topic && <div class="workshop-topic">{workshop.data.topic}</div>}
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="cv-actions">
    <button class="download-btn" onclick="window.print(); return false;">Print CV as PDF</button>
  </nav>
</BaseLayout>

<style>
  h1 {
    font-size: 3rem;
    margin-bottom: 3rem;
  }

  section {
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #333;
    padding-bottom: 0.5rem;
  }

  ul {
    list-style: disc;
    padding-left: 2rem;
  }

  li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .timeline {
    border-left: 2px solid #2d7a3e;
    padding-left: 2rem;
  }

  .timeline-item {
    margin-bottom: 2.5rem;
    position: relative;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -2.375rem;
    top: 0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    background: #2d7a3e;
    border-radius: 50%;
  }

  .timeline-date {
    font-size: 0.9rem;
    font-weight: 600;
    color: #666;
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .org-name {
    font-size: 1.1rem;
    color: #333;
  }

  .org-location {
    color: #666;
    margin-top: 0.25rem;
  }

  .honors {
    color: #2d7a3e;
    font-style: italic;
    margin-top: 0.5rem;
    font-size: 0.95rem;
  }

  .awards-list {
    list-style: none;
    padding: 0;
  }

  .awards-list li {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }

  .awards-list li:last-child {
    border-bottom: none;
  }

  .award-meta {
    color: #666;
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .recordings-list,
  .workshops-list {
    list-style: none;
    padding: 0;
  }

  .recordings-list li,
  .workshops-list li {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }

  .recordings-list li:last-child,
  .workshops-list li:last-child {
    border-bottom: none;
  }

  .recording-meta,
  .workshop-meta {
    color: #666;
    font-size: 0.95rem;
    margin-top: 0.25rem;
  }

  .recording-format {
    color: #2d7a3e;
    font-size: 0.85rem;
    margin-top: 0.25rem;
    font-weight: 500;
  }

  .workshop-topic {
    color: #666;
    font-size: 0.9rem;
    font-style: italic;
    margin-top: 0.5rem;
  }

  .cv-actions {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px solid #ddd;
  }

  .download-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #2d7a3e;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    font-family: inherit;
  }

  .download-btn:hover {
    background: #246330;
  }

  @media print {
    /* Hide navigation and actions */
    nav,
    .cv-actions,
    header,
    footer {
      display: none !important;
    }

    /* Reset page margins */
    @page {
      margin: 0.5in;
    }

    body {
      font-size: 9pt;
      line-height: 1.3;
    }

    /* Compact heading sizes */
    h1 {
      font-size: 18pt;
      margin-bottom: 0.5rem;
    }

    h2 {
      font-size: 11pt;
      margin-bottom: 0.3rem;
      margin-top: 0.5rem;
      padding-bottom: 0.15rem;
      border-bottom: 1px solid #333;
      page-break-after: avoid;
    }

    h3 {
      font-size: 10pt;
      margin-bottom: 0.1rem;
    }

    /* Compact sections */
    section {
      margin-bottom: 0.75rem;
    }

    /* Prevent breaks right after headings */
    h1,
    h2,
    h3 {
      page-break-after: avoid;
    }

    /* Keep timeline and lists together when possible */
    .timeline,
    .awards-list,
    .recordings-list,
    .workshops-list {
      page-break-inside: auto;
    }

    /* Compact timeline */
    .timeline {
      border-left: 1px solid #333;
      padding-left: 0.75rem;
    }

    .timeline-item {
      margin-bottom: 0.4rem;
      page-break-inside: avoid;
    }

    .timeline-item::before {
      width: 0.35rem;
      height: 0.35rem;
      left: -0.93rem;
      top: 0.2rem;
    }

    .timeline-date {
      font-size: 8pt;
      margin-bottom: 0.1rem;
    }

    .org-name {
      font-size: 9pt;
    }

    .org-location,
    .honors {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Compact lists */
    .awards-list,
    .recordings-list,
    .workshops-list {
      padding: 0;
    }

    .awards-list li,
    .recordings-list li,
    .workshops-list li {
      margin-bottom: 0.3rem;
      padding-bottom: 0.3rem;
      border-bottom: none;
      page-break-inside: avoid;
    }

    .award-meta,
    .recording-meta,
    .workshop-meta {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    .recording-format,
    .workshop-topic {
      font-size: 8pt;
      margin-top: 0.1rem;
    }

    /* Ensure compact line heights throughout */
    p,
    li,
    div {
      line-height: 1.3;
    }

    /* Remove background colors */
    * {
      background: white !important;
      color: black !important;
    }

    /* Preserve important colors */
    h2 {
      border-bottom-color: black !important;
    }
  }
</style>
