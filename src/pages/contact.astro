      <li><a href="https://instagram.com/yourusername" target="_blank" rel="noopener noreferrer" class="text-[#2d7a3e] no-underline text-lg hover:underline">Instagram</a></li>
      <li><a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer" class="text-[#2d7a3e] no-underline text-lg hover:underline">Twitter/X</a></li>
      <li><a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer" class="text-[#2d7a3e] no-underline text-lg hover:underline">LinkedIn</a></li>
      <li><a href="https://youtube.com/@yourusername" target="_blank" rel="noopener noreferrer" class="text-[#2d7a3e] no-underline text-lg hover:underline">YouTube</a></li>
    </ul>
  </section> -->
</BaseLayout>
