---
import { Button } from '@/components/ui/button';

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Davis Ponjuan" description="Get in touch for bookings and inquiries">
  <header class="section fade-in">
    <h1 class="mb-6">Contact</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      For conducting engagements, guest appearances, and masterclass inquiries.
    </p>
  </header>

  <hr class="divider-dashed" />

  <section class="section fade-in-up delay-1">
    <h2 class="section-heading">Booking Inquiries</h2>
    <div class="bg-card border border-border rounded-lg p-8 mt-6">
      <p class="mb-4">
        <strong>Email:</strong>
        <span class="text-muted-foreground">[your.email@example.com]</span>
      </p>
      <p class="mb-4">
        <strong>Phone:</strong>
        <span class="text-muted-foreground">[Your phone number]</span>
      </p>
      <p class="mb-0">
        <strong>Management:</strong>
        <span class="text-muted-foreground">[Management company name, if applicable]</span>
      </p>
    </div>
  </section>

  <section class="section fade-in-up delay-2">
    <h2 class="section-heading">General Contact</h2>
    <form class="max-w-xl space-y-6">
      <div>
        <label for="name" class="block mb-2 font-semibold text-sm uppercase tracking-wide"
          >Name</label
        >
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full p-4 border border-border rounded-md text-base bg-background outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300"
        />
      </div>

      <div>
        <label for="email" class="block mb-2 font-semibold text-sm uppercase tracking-wide"
          >Email</label
        >
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full p-4 border border-border rounded-md text-base bg-background outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300"
        />
      </div>

      <div>
        <label for="subject" class="block mb-2 font-semibold text-sm uppercase tracking-wide"
          >Subject</label
        >
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full p-4 border border-border rounded-md text-base bg-background outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300"
        />
      </div>

      <div>
        <label for="message" class="block mb-2 font-semibold text-sm uppercase tracking-wide"
          >Message</label
        >
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full p-4 border border-border rounded-md text-base bg-background outline-none focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300 resize-y"
        ></textarea>
      </div>

      <Button size="xl" className="w-full sm:w-auto">Send Message</Button>
    </form>

    <!-- TODO: Connect form to backend (Formspree, Netlify Forms, etc.) before going live -->
    <!-- <p class="mt-4 text-sm text-gray-600 italic">
      Note: This is a placeholder form. You'll need to connect it to a backend service (Formspree,
      Netlify Forms, etc.) to actually receive messages.
    </p> -->
  </section>

