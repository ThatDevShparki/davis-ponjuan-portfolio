---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Davis Ponjuan" description="Get in touch for bookings and inquiries">
  <h1 class="text-5xl mb-8">Contact</h1>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Booking Inquiries</h2>
    <p>For conducting engagements, guest appearances, and masterclass inquiries, please contact:</p>

    <div class="bg-gray-100 p-8 rounded mt-4">
      <p class="mb-3"><strong>Email:</strong> [your.email@example.com]</p>
      <p class="mb-3"><strong>Phone:</strong> [Your phone number]</p>
      <p class="mb-3"><strong>Management:</strong> [Management company name, if applicable]</p>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">General Contact</h2>
    <form class="max-w-xl">
      <div class="mb-6">
        <label for="name" class="block mb-2 font-semibold">Name</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full p-3 border border-gray-300 rounded text-base font-[inherit] outline-none focus:border-[#2d7a3e] focus:shadow-[0_0_0_3px_rgba(45,122,62,0.1)]"
        />
      </div>

      <div class="mb-6">
        <label for="email" class="block mb-2 font-semibold">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full p-3 border border-gray-300 rounded text-base font-[inherit] outline-none focus:border-[#2d7a3e] focus:shadow-[0_0_0_3px_rgba(45,122,62,0.1)]"
        />
      </div>

      <div class="mb-6">
        <label for="subject" class="block mb-2 font-semibold">Subject</label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full p-3 border border-gray-300 rounded text-base font-[inherit] outline-none focus:border-[#2d7a3e] focus:shadow-[0_0_0_3px_rgba(45,122,62,0.1)]"
        />
      </div>

      <div class="mb-6">
        <label for="message" class="block mb-2 font-semibold">Message</label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          class="w-full p-3 border border-gray-300 rounded text-base font-[inherit] outline-none focus:border-[#2d7a3e] focus:shadow-[0_0_0_3px_rgba(45,122,62,0.1)] resize-y"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-[#2d7a3e] text-white py-3 px-8 border-none rounded text-base font-semibold cursor-pointer hover:bg-[#246330]"
        >Send Message</button
      >
    </form>

    <!-- TODO: Connect form to backend (Formspree, Netlify Forms, etc.) before going live -->
    <!-- <p class="mt-4 text-sm text-gray-600 italic">
      Note: This is a placeholder form. You'll need to connect it to a backend service (Formspree,
      Netlify Forms, etc.) to actually receive messages.
    </p> -->
  </section>

