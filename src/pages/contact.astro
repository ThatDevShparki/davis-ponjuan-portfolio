---
import { Button } from '@/components/ui/button';

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Davis Ponjuán" description="Get in touch for bookings and inquiries">
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Contact</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Interested in a conducting engagement, guest appearance, or masterclass? Get in touch.
    </p>
  </header>

  <hr class="divider-dashed" />

  <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
    <!-- Contact Info Sidebar -->
    <aside class="lg:col-span-2 fade-in-up delay-1">
      <h2 class="text-nav text-muted-foreground mb-4">Booking Inquiries</h2>
      <div class="bg-card border border-border rounded-md p-5 space-y-3">
        <div>
          <div class="text-xs text-muted-foreground uppercase tracking-wide mb-1">Email</div>
          <a
            href="mailto:bookings@davisponjuan.com"
            class="text-sm hover:text-primary transition-colors">bookings@davisponjuan.com</a
          >
        </div>
        <div>
          <div class="text-xs text-muted-foreground uppercase tracking-wide mb-1">
            Response Time
          </div>
          <div class="text-sm">Usually within 2–3 business days</div>
        </div>
        <div>
          <div class="text-xs text-muted-foreground uppercase tracking-wide mb-1">
            For Press Inquiries
          </div>
          <a
            href="mailto:press@davisponjuan.com"
            class="text-sm hover:text-primary transition-colors">press@davisponjuan.com</a
          >
        </div>
      </div>
    </aside>

    <!-- Contact Form -->
    <section class="lg:col-span-3 fade-in-up delay-2">
      <h2 class="text-nav text-muted-foreground mb-4">Send a Message</h2>
      <form class="space-y-4">
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block mb-1.5 text-xs font-medium uppercase tracking-wide"
              >Your Name</label
            >
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Jane Smith"
              required
              class="w-full px-3 py-2.5 border border-border rounded-md text-sm bg-background outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all duration-300"
            />
          </div>
          <div>
            <label for="email" class="block mb-1.5 text-xs font-medium uppercase tracking-wide"
              >Email Address</label
            >
            <input
              type="email"
              id="email"
              name="email"
              placeholder="jane@orchestra.org"
              required
              class="w-full px-3 py-2.5 border border-border rounded-md text-sm bg-background outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all duration-300"
            />
          </div>
        </div>

        <div>
          <label for="subject" class="block mb-1.5 text-xs font-medium uppercase tracking-wide"
            >Subject</label
          >
          <input
            type="text"
            id="subject"
            name="subject"
            placeholder="Guest conducting inquiry for 2025-26 season"
            required
            class="w-full px-3 py-2.5 border border-border rounded-md text-sm bg-background outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all duration-300"
          />
        </div>

        <div>
          <label for="message" class="block mb-1.5 text-xs font-medium uppercase tracking-wide"
            >Message</label
          >
          <textarea
            id="message"
            name="message"
            rows="5"
            placeholder="Please include dates, repertoire interests, and any relevant details about your organization."
            required
            class="w-full px-3 py-2.5 border border-border rounded-md text-sm bg-background outline-none focus:border-primary focus:ring-1 focus:ring-primary/20 transition-all duration-300 resize-y"
          ></textarea>
        </div>

        <Button className="w-full sm:w-auto">Send Message</Button>
      </form>
    </section>
  </div>
</BaseLayout>
