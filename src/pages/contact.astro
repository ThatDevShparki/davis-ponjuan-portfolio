---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact - Davis Ponjuan" description="Get in touch for bookings and inquiries">
  <h1>Contact</h1>

  <section>
    <h2>Booking Inquiries</h2>
    <p>For conducting engagements, guest appearances, and masterclass inquiries, please contact:</p>

    <div class="contact-info">
      <p><strong>Email:</strong> [your.email@example.com]</p>
      <p><strong>Phone:</strong> [Your phone number]</p>
      <p><strong>Management:</strong> [Management company name, if applicable]</p>
    </div>
  </section>

  <section>
    <h2>General Contact</h2>
    <form class="contact-form">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="form-group">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" required />
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit">Send Message</button>
    </form>

    <!-- TODO: Connect form to backend (Formspree, Netlify Forms, etc.) before going live -->
    <!-- <p class="form-note">
      Note: This is a placeholder form. You'll need to connect it to a backend service (Formspree,
      Netlify Forms, etc.) to actually receive messages.
    </p> -->
  </section>

  <!-- TODO: Add your actual social media URLs before going live -->
  <!-- <section>
    <h2>Social Media</h2>
    <ul class="social-links">
      <li><a href="https://instagram.com/yourusername" target="_blank" rel="noopener noreferrer">Instagram</a></li>
      <li><a href="https://twitter.com/yourusername" target="_blank" rel="noopener noreferrer">Twitter/X</a></li>
      <li><a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="https://youtube.com/@yourusername" target="_blank" rel="noopener noreferrer">YouTube</a></li>
    </ul>
  </section> -->
</BaseLayout>

<style>
  h1 {
    font-size: 3rem;
    margin-bottom: 2rem;
  }

  section {
    margin-bottom: 4rem;
  }

  h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 2px solid #333;
    padding-bottom: 0.5rem;
  }

  .contact-info {
    background: #f8f8f8;
    padding: 2rem;
    border-radius: 4px;
    margin-top: 1rem;
  }

  .contact-info p {
    margin-bottom: 0.75rem;
  }

  .contact-form {
    max-width: 600px;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: #2d7a3e;
    box-shadow: 0 0 0 3px rgba(45, 122, 62, 0.1);
  }

  textarea {
    resize: vertical;
  }

  button {
    background: #2d7a3e;
    color: white;
    padding: 0.75rem 2rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    background: #246330;
  }

  .form-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: #666;
    font-style: italic;
  }

  .social-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 2rem;
  }

  .social-links a {
    color: #2d7a3e;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .social-links a:hover {
    text-decoration: underline;
  }
</style>
