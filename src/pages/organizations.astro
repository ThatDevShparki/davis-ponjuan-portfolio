---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');

// Group by type
const current = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const past = allOrganizations
  .filter((org) => org.data.type === 'past')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const guest = allOrganizations
  .filter((org) => org.data.type === 'guest')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const educational = allOrganizations
  .filter((org) => org.data.type === 'educational')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Organizations - Davis Ponjuán"
  description="Current and past musical positions and affiliations"
>
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Organizations</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Current and past musical positions and affiliations.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    current.length > 0 && (
      <section class="mb-10 fade-in-up delay-1">
        <h2 class="text-nav text-muted-foreground mb-4">Current Positions</h2>
        <div class="divide-y divide-border">
          {current.map(async (org) => {
            const { Content } = await org.render();
            return (
              <article class="py-5 first:pt-0">
                <h3 class="text-xl font-serif text-primary mb-1">{org.data.role}</h3>
                <div class="font-medium mb-2">{org.data.name}</div>
                <div class="text-xs text-muted-foreground mb-3 flex flex-wrap gap-x-3">
                  <span>{org.data.location}</span>
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}{' '}
                    – Present
                  </span>
                  {org.data.website && (
                    <a
                      href={org.data.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline underline-offset-4"
                    >
                      Website
                    </a>
                  )}
                </div>
                <div class="text-sm text-muted-foreground">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  {
    educational.length > 0 && (
      <section class="mb-10 fade-in-up delay-2">
        <h2 class="text-nav text-muted-foreground mb-4">Educational & Teaching</h2>
        <div class="divide-y divide-border">
          {educational.map(async (org) => {
            const { Content } = await org.render();
            return (
              <article class="py-5 first:pt-0">
                <h3 class="text-xl font-serif text-primary mb-1">{org.data.role}</h3>
                <div class="font-medium mb-2">{org.data.name}</div>
                <div class="text-xs text-muted-foreground mb-3 flex flex-wrap gap-x-3">
                  <span>{org.data.location}</span>
                  {org.data.website && (
                    <a
                      href={org.data.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-primary hover:underline underline-offset-4"
                    >
                      Website
                    </a>
                  )}
                </div>
                <div class="text-sm text-muted-foreground">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="mb-10 fade-in-up delay-3">
        <h2 class="text-nav text-muted-foreground mb-4">Past Positions</h2>
        <div class="divide-y divide-border">
          {past.map(async (org) => {
            const { Content } = await org.render();
            return (
              <article class="py-5 first:pt-0">
                <h3 class="text-lg font-serif text-primary mb-1">{org.data.role}</h3>
                <div class="font-medium mb-2">{org.data.name}</div>
                <div class="text-xs text-muted-foreground mb-3 flex flex-wrap gap-x-3">
                  <span>{org.data.location}</span>
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}{' '}
                    –{' '}
                    {org.data.endDate?.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </span>
                </div>
                <div class="text-sm text-muted-foreground">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  {
    guest.length > 0 && (
      <section class="mb-10 fade-in-up delay-4">
        <h2 class="text-nav text-muted-foreground mb-4">Guest Conducting</h2>
        <div class="divide-y divide-border">
          {guest.map(async (org) => {
            const { Content } = await org.render();
            return (
              <article class="py-4 first:pt-0">
                <h3 class="text-base font-serif text-primary">{org.data.name}</h3>
                <div class="text-xs text-muted-foreground mt-1 flex flex-wrap gap-x-3">
                  <span>{org.data.location}</span>
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                    {org.data.endDate &&
                      org.data.endDate.getTime() !== org.data.startDate.getTime() &&
                      ` – ${org.data.endDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                      })}`}
                  </span>
                </div>
                <div class="text-sm text-muted-foreground mt-2">
                  <Content />
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }
</BaseLayout>
