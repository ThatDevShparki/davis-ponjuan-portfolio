---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');

// Group by type
const current = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const past = allOrganizations
  .filter((org) => org.data.type === 'past')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const guest = allOrganizations
  .filter((org) => org.data.type === 'guest')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const educational = allOrganizations
  .filter((org) => org.data.type === 'educational')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Organizations - Davis Ponjuan"
  description="Current and past musical positions and affiliations"
>
  <header class="section fade-in">
    <h1 class="mb-6">Organizations</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      Current and past musical positions and affiliations.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    current.length > 0 && (
      <section class="section fade-in-up delay-1">
        <h2 class="section-heading">Current Positions</h2>
        <ul class="list-none p-0">
          {current.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-border last:border-b-0">
                <h3 class="text-2xl font-serif mb-2 text-primary">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="metadata mb-4 flex flex-wrap gap-x-1">
                  <span>{org.data.location}</span>
                  <span class="metadata-separator" />
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                    })}{' '}
                    – Present
                  </span>
                  {org.data.website && (
                    <>
                      <span class="metadata-separator" />
                      <a
                        href={org.data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary hover:underline underline-offset-4"
                      >
                        Website
                      </a>
                    </>
                  )}
                </div>
                <div class="leading-relaxed text-muted-foreground">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    educational.length > 0 && (
      <section class="section fade-in-up delay-2">
        <h2 class="section-heading">Educational & Teaching</h2>
        <ul class="list-none p-0">
          {educational.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-border last:border-b-0">
                <h3 class="text-2xl font-serif mb-2 text-primary">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="metadata mb-4 flex flex-wrap gap-x-1">
                  <span>{org.data.location}</span>
                  {org.data.website && (
                    <>
                      <span class="metadata-separator" />
                      <a
                        href={org.data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-primary hover:underline underline-offset-4"
                      >
                        Website
                      </a>
                    </>
                  )}
                </div>
                <div class="leading-relaxed text-muted-foreground">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section class="section fade-in-up delay-3">
        <h2 class="section-heading">Past Positions</h2>
        <ul class="list-none p-0">
          {past.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-border last:border-b-0">
                <h3 class="text-2xl font-serif mb-2 text-primary">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="metadata mb-4 flex flex-wrap gap-x-1">
                  <span>{org.data.location}</span>
                  <span class="metadata-separator" />
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                    })}{' '}
                    –{' '}
                    {org.data.endDate?.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                    })}
                  </span>
                </div>
                <div class="leading-relaxed text-muted-foreground">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    guest.length > 0 && (
      <section class="section fade-in-up delay-4">
        <h2 class="section-heading">Guest Conducting</h2>
        <ul class="list-none p-0">
          {guest.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-border last:border-b-0">
                <h3 class="text-2xl font-serif mb-2 text-primary">{org.data.name}</h3>
                <div class="metadata mb-4 flex flex-wrap gap-x-1">
                  <span>{org.data.location}</span>
                  <span class="metadata-separator" />
                  <span>
                    {org.data.startDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                    })}
                    {org.data.endDate &&
                      org.data.endDate.getTime() !== org.data.startDate.getTime() &&
                      ` – ${org.data.endDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                      })}`}
                  </span>
                </div>
                <div class="leading-relaxed text-muted-foreground">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</BaseLayout>
