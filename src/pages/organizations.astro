---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');

// Group by type
const current = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const past = allOrganizations
  .filter((org) => org.data.type === 'past')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const guest = allOrganizations
  .filter((org) => org.data.type === 'guest')
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const educational = allOrganizations
  .filter((org) => org.data.type === 'educational')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Organizations - Davis Ponjuan"
  description="Current and past musical positions and affiliations"
>
  <h1 class="text-5xl mb-8">Organizations</h1>

  {
    current.length > 0 && (
      <section>
        <h2 class="text-3xl mb-6 mt-12 border-b-2 border-gray-800 pb-2 first:mt-0">
          Current Positions
        </h2>
        <ul class="list-none p-0">
          {current.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-gray-200 last:border-b-0">
                <h3 class="text-2xl mb-2 text-[#2d7a3e]">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="text-gray-600 mb-4">
                  {org.data.location} •{' '}
                  {org.data.startDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                  })}{' '}
                  – Present
                  {org.data.website && (
                    <>
                      {' '}
                      •{' '}
                      <a
                        href={org.data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#2d7a3e] no-underline hover:underline"
                      >
                        Website
                      </a>
                    </>
                  )}
                </div>
                <div class="leading-relaxed">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    educational.length > 0 && (
      <section>
        <h2 class="text-3xl mb-6 mt-12 border-b-2 border-gray-800 pb-2">Educational & Teaching</h2>
        <ul class="list-none p-0">
          {educational.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-gray-200 last:border-b-0">
                <h3 class="text-2xl mb-2 text-[#2d7a3e]">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="text-gray-600 mb-4">
                  {org.data.location}
                  {org.data.website && (
                    <>
                      {' '}
                      •{' '}
                      <a
                        href={org.data.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-[#2d7a3e] no-underline hover:underline"
                      >
                        Website
                      </a>
                    </>
                  )}
                </div>
                <div class="leading-relaxed">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    past.length > 0 && (
      <section>
        <h2 class="text-3xl mb-6 mt-12 border-b-2 border-gray-800 pb-2">Past Positions</h2>
        <ul class="list-none p-0">
          {past.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-gray-200 last:border-b-0">
                <h3 class="text-2xl mb-2 text-[#2d7a3e]">{org.data.role}</h3>
                <div class="text-xl font-semibold mb-2">{org.data.name}</div>
                <div class="text-gray-600 mb-4">
                  {org.data.location} •{' '}
                  {org.data.startDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                  })}{' '}
                  –{' '}
                  {org.data.endDate?.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                  })}
                </div>
                <div class="leading-relaxed">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  {
    guest.length > 0 && (
      <section>
        <h2 class="text-3xl mb-6 mt-12 border-b-2 border-gray-800 pb-2">Guest Conducting</h2>
        <ul class="list-none p-0">
          {guest.map(async (org) => {
            const { Content } = await org.render();
            return (
              <li class="mb-12 pb-12 border-b border-gray-200 last:border-b-0">
                <h3 class="text-2xl mb-2 text-[#2d7a3e]">{org.data.name}</h3>
                <div class="text-gray-600 mb-4">
                  {org.data.location} •{' '}
                  {org.data.startDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                  })}
                  {org.data.endDate &&
                    org.data.endDate.getTime() !== org.data.startDate.getTime() &&
                    ` – ${org.data.endDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                    })}`}
                </div>
                <div class="leading-relaxed">
                  <Content />
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</BaseLayout>
