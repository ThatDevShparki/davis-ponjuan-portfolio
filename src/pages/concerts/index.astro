---
import { getCollection } from 'astro:content';

import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allConcerts = await getCollection('concerts');

// Separate upcoming and past concerts
const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastConcerts = allConcerts
  .filter((concert) => concert.data.status === 'past')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group past concerts by year
const concertsByYear = pastConcerts.reduce(
  (acc, concert) => {
    const year = concert.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(concert);
    return acc;
  },
  {} as Record<number, typeof pastConcerts>
);

const years = Object.keys(concertsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Concerts - Davis Ponjuan"
  description="Concert history and upcoming performances"
>
  <h1 class="text-5xl mb-8">Concerts</h1>

  {
    upcomingConcerts.length > 0 && (
      <section class="mb-16">
        <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Upcoming Performances</h2>
        <ul class="list-none p-0">
          {upcomingConcerts.map((concert) => (
            <li class="flex gap-8 mb-8 pb-8 border-b border-gray-200 last:border-b-0">
              <div class="flex-shrink-0 w-30 font-semibold text-gray-600">
                {concert.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </div>
              <div class="flex-1">
                <h3 class="m-0 mb-2 text-xl">
                  <a
                    href={`/concerts/${concert.id}`}
                    class="text-gray-800 no-underline hover:text-[#2d7a3e] hover:underline"
                  >
                    {concert.data.title}
                  </a>
                </h3>
                <div class="text-gray-600 mb-2">
                  {concert.data.orchestra} • {concert.data.venue}, {concert.data.location}
                </div>
                {concert.data.program && (
                  <ul class="list-none p-0 text-[0.95rem] text-gray-600 mt-2">
                    {concert.data.program.map((piece) => (
                      <li class="mb-1">
                        {piece.composer}: <em>{piece.work}</em>
                        {piece.soloist && ` (${piece.soloist})`}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mb-16">
    <h2 class="text-3xl mb-6 border-b-2 border-gray-800 pb-2">Past Performances</h2>
    {
      years.length === 0 && (
        <EmptyState
          title="No past performances yet"
          message="Check back soon for concert history and archive."
        />
      )
    }
    {
      years.map((year) => (
        <div class="mb-12">
          <h3 class="text-2xl font-bold mb-4 text-[#2d7a3e]">{year}</h3>
          <ul class="list-none p-0">
            {concertsByYear[year].map((concert) => (
              <li class="flex gap-8 mb-8 pb-8 border-b border-gray-200 last:border-b-0">
                <div class="flex-shrink-0 w-30 font-semibold text-gray-600">
                  {concert.data.date.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                  })}
                </div>
                <div class="flex-1">
                  <h4 class="m-0 mb-2 text-lg">
                    <a
                      href={`/concerts/${concert.id}`}
                      class="text-gray-800 no-underline hover:text-[#2d7a3e] hover:underline"
                    >
                      {concert.data.title}
                    </a>
                    {concert.data.featured && (
                      <span class="inline-block bg-[#2d7a3e] text-white py-0.5 px-2 text-xs rounded ml-2 font-normal">
                        Featured
                      </span>
                    )}
                  </h4>
                  <div class="text-gray-600 mb-2">
                    {concert.data.orchestra} • {concert.data.venue}, {concert.data.location}
                  </div>
                  {concert.data.program && concert.data.program.length > 0 && (
                    <div class="text-[0.95rem] text-gray-600 mt-2">
                      {concert.data.program[0].composer}: <em>{concert.data.program[0].work}</em>
                      {concert.data.program.length > 1 &&
                        ` + ${concert.data.program.length - 1} more`}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
