---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allConcerts = await getCollection('concerts');

// Separate upcoming and past concerts
const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastConcerts = allConcerts
  .filter((concert) => concert.data.status === 'past')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Featured past concerts
const featuredConcerts = pastConcerts.filter((c) => c.data.featured).slice(0, 3);

// Helper to get cover image src
function getCoverImageSrc(coverImage: string | { src: string } | undefined): string | undefined {
  if (!coverImage) return undefined;
  if (typeof coverImage === 'string') return coverImage;
  return coverImage.src;
}

// Group past concerts by year
const concertsByYear = pastConcerts.reduce(
  (acc, concert) => {
    const year = concert.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(concert);
    return acc;
  },
  {} as Record<number, typeof pastConcerts>
);

const years = Object.keys(concertsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Concerts - Davis Ponjuan"
  description="Concert history and upcoming performances"
>
  <header class="mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Concerts</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Upcoming performances and a complete archive of past concerts.
    </p>
  </header>

  <hr class="divider-dashed" />

  <!-- Upcoming Performances -->
  {
    upcomingConcerts.length > 0 && (
      <section class="mb-10 fade-in-up delay-1">
        <h2 class="text-nav text-muted-foreground mb-4">Upcoming Performances</h2>

        <div class="space-y-4">
          {upcomingConcerts.map((concert, index) => (
            <article
              class={`group border border-primary rounded-md overflow-hidden bg-card fade-in-up delay-${Math.min(index + 2, 5)}`}
            >
              <div class="p-5 md:p-6">
                <div class="flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
                  {/* Date block */}
                  <div class="md:w-20 flex-shrink-0 text-center md:text-left">
                    <div class="text-3xl font-serif text-primary leading-none">
                      {concert.data.date.toLocaleDateString('en-US', { day: 'numeric' })}
                    </div>
                    <div class="text-nav text-muted-foreground mt-1">
                      {concert.data.date.toLocaleDateString('en-US', {
                        month: 'short',
                        year: 'numeric',
                      })}
                    </div>
                  </div>

                  {/* Content */}
                  <div class="flex-1">
                    <h3 class="text-xl font-serif mb-2 group-hover:text-primary transition-colors duration-300">
                      <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                    </h3>

                    <div class="flex flex-wrap gap-3 text-sm text-muted-foreground mb-3">
                      <span class="flex items-center gap-1">
                        <svg
                          class="w-3.5 h-3.5 text-primary"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        {concert.data.venue}, {concert.data.location}
                      </span>
                      <span>·</span>
                      <span>{concert.data.orchestra}</span>
                    </div>

                    {concert.data.program && concert.data.program.length > 0 && (
                      <div class="text-sm">
                        {concert.data.program.slice(0, 2).map((piece) => (
                          <div class="mb-1">
                            <span class="font-medium">{piece.composer}</span>:{' '}
                            <span class="font-serif italic">{piece.work}</span>
                            {piece.soloist && <span class="text-primary"> ({piece.soloist})</span>}
                          </div>
                        ))}
                        {concert.data.program.length > 2 && (
                          <div class="text-muted-foreground">
                            +{concert.data.program.length - 2} more
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </div>
              </div>
              <div class="h-0.5 bg-primary" />
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Featured Past Performances -->
  {
    featuredConcerts.length > 0 && (
      <section class="mb-10 fade-in-up delay-2">
        <h2 class="text-nav text-muted-foreground mb-4">Highlights</h2>

        <div class="grid md:grid-cols-3 gap-4">
          {featuredConcerts.map((concert, index) => {
            const coverSrc = getCoverImageSrc(concert.data.coverImage);
            return (
              <article
                class={`group overflow-hidden border border-border rounded-md bg-card hover:border-primary transition-all duration-300 fade-in-up delay-${Math.min(index + 3, 5)}`}
              >
                {/* Cover Image */}
                {coverSrc && (
                  <a href={`/concerts/${concert.id}`} class="block overflow-hidden">
                    <img
                      src={coverSrc}
                      alt={concert.data.title}
                      class="w-full aspect-[16/10] object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="p-4">
                  <Badge variant="featured" className="mb-2 text-[10px]">
                    Featured
                  </Badge>
                  <div class="text-nav text-muted-foreground mb-1">
                    {concert.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </div>
                  <h3 class="text-sm font-serif mb-2 leading-tight group-hover:text-primary transition-colors duration-300">
                    <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                  </h3>
                  <div class="text-xs text-muted-foreground">
                    {concert.data.orchestra} · {concert.data.venue}
                  </div>

                  {/* Video link if available */}
                  {concert.data.videos && concert.data.videos.length > 0 && (
                    <a
                      href={concert.data.videos[0].src}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 mt-3 text-xs text-primary hover:underline"
                    >
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      Watch Performance
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- Past Performances Archive -->
  <section class="fade-in-up delay-3">
    <h2 class="text-nav text-muted-foreground mb-4">Archive</h2>
    {
      years.length === 0 && (
        <EmptyState
          title="No past performances yet"
          message="Check back soon for concert history and archive."
        />
      )
    }
    {
      years.map((year, yearIndex) => (
        <div class={`mb-8 fade-in-up delay-${Math.min(yearIndex + 4, 5)}`}>
          <h3 class="text-2xl font-serif text-primary mb-3 pb-1 border-b border-primary inline-block">
            {year}
          </h3>
          <ul class="divide-y divide-border">
            {concertsByYear[year].map((concert) => (
              <li class="group py-3 first:pt-0">
                <div class="flex gap-4">
                  <div class="w-12 flex-shrink-0">
                    <span class="text-nav text-muted-foreground">
                      {concert.data.date.toLocaleDateString('en-US', {
                        month: 'short',
                        day: 'numeric',
                      })}
                    </span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="text-base font-serif group-hover:text-primary transition-colors duration-300 truncate">
                      <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                    </h4>
                    <div class="text-xs text-muted-foreground mt-0.5 truncate">
                      {concert.data.orchestra} · {concert.data.venue}
                    </div>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
