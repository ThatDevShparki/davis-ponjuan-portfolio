---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allConcerts = await getCollection('concerts');

// Separate upcoming and past concerts
const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastConcerts = allConcerts
  .filter((concert) => concert.data.status === 'past')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Group past concerts by year
const concertsByYear = pastConcerts.reduce(
  (acc, concert) => {
    const year = concert.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(concert);
    return acc;
  },
  {} as Record<number, typeof pastConcerts>
);

const years = Object.keys(concertsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Concerts - Davis Ponjuan"
  description="Concert history and upcoming performances"
>
  <header class="section fade-in">
    <h1 class="mb-6">Concerts</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      Upcoming performances and a complete archive of past concerts.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    upcomingConcerts.length > 0 && (
      <section class="section fade-in-up delay-1">
        <h2 class="section-heading">Upcoming Performances</h2>
        <ul class="list-none p-0">
          {upcomingConcerts.map((concert) => (
            <li class="flex flex-col md:flex-row gap-4 md:gap-12 list-divider py-8">
              <div class="flex-shrink-0 md:w-36">
                <span class="metadata">
                  {concert.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </span>
              </div>
              <div class="flex-1">
                <h3 class="m-0 mb-3 text-xl md:text-2xl font-serif">
                  <a
                    href={`/concerts/${concert.id}`}
                    class="hover:text-primary transition-colors duration-300"
                  >
                    {concert.data.title}
                  </a>
                </h3>
                <div class="metadata mb-3 flex flex-wrap gap-x-1">
                  <span>{concert.data.orchestra}</span>
                  <span class="metadata-separator" />
                  <span>
                    {concert.data.venue}, {concert.data.location}
                  </span>
                </div>
                {concert.data.program && (
                  <ul class="list-none p-0 text-sm text-muted-foreground mt-4 space-y-1">
                    {concert.data.program.map((piece) => (
                      <li>
                        <span class="font-medium text-foreground">{piece.composer}</span>:{' '}
                        <em>{piece.work}</em>
                        {piece.soloist && <span class="text-primary"> ({piece.soloist})</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <hr class="divider-dashed" />

  <section class="section fade-in-up delay-2">
    <h2 class="section-heading">Past Performances</h2>
    {
      years.length === 0 && (
        <EmptyState
          title="No past performances yet"
          message="Check back soon for concert history and archive."
        />
      )
    }
    {
      years.map((year, yearIndex) => (
        <div class={`mb-16 fade-in-up delay-${Math.min(yearIndex + 2, 5)}`}>
          <h3 class="text-4xl font-serif text-primary mb-8 border-b-2 border-primary pb-2 inline-block">
            {year}
          </h3>
          <ul class="list-none p-0">
            {concertsByYear[year].map((concert) => (
              <li class="flex flex-col md:flex-row gap-4 md:gap-12 list-divider py-6">
                <div class="flex-shrink-0 md:w-24">
                  <span class="metadata">
                    {concert.data.date.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                </div>
                <div class="flex-1">
                  <h4 class="m-0 mb-2 text-lg md:text-xl font-serif flex flex-wrap items-center gap-3">
                    <a
                      href={`/concerts/${concert.id}`}
                      class="hover:text-primary transition-colors duration-300"
                    >
                      {concert.data.title}
                    </a>
                    {concert.data.featured && <Badge variant="featured">Featured</Badge>}
                  </h4>
                  <div class="metadata mb-2 flex flex-wrap gap-x-1">
                    <span>{concert.data.orchestra}</span>
                    <span class="metadata-separator" />
                    <span>
                      {concert.data.venue}, {concert.data.location}
                    </span>
                  </div>
                  {concert.data.program && concert.data.program.length > 0 && (
                    <div class="text-sm text-muted-foreground mt-3">
                      <span class="font-medium text-foreground">
                        {concert.data.program[0].composer}
                      </span>
                      : <em>{concert.data.program[0].work}</em>
                      {concert.data.program.length > 1 && (
                        <span class="text-primary"> + {concert.data.program.length - 1} more</span>
                      )}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
