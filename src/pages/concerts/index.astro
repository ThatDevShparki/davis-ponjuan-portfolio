---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import EmptyState from '../../components/EmptyState.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allConcerts = await getCollection('concerts');

// Separate upcoming and past concerts
const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());

const pastConcerts = allConcerts
  .filter((concert) => concert.data.status === 'past')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Featured past concerts (for hero section)
const featuredConcerts = pastConcerts.filter((c) => c.data.featured).slice(0, 3);

// Group past concerts by year
const concertsByYear = pastConcerts.reduce(
  (acc, concert) => {
    const year = concert.data.date.getFullYear();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(concert);
    return acc;
  },
  {} as Record<number, typeof pastConcerts>
);

const years = Object.keys(concertsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<BaseLayout
  title="Concerts - Davis Ponjuan"
  description="Concert history and upcoming performances"
>
  <header class="section fade-in">
    <h1 class="mb-6">Concerts</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      Upcoming performances and a complete archive of past concerts.
    </p>
  </header>

  <hr class="divider-dashed" />

  <!-- Upcoming Performances - Hero Treatment -->
  {
    upcomingConcerts.length > 0 && (
      <section class="mb-16 fade-in-up delay-1">
        <h2 class="text-nav text-muted-foreground mb-8">Upcoming Performances</h2>

        <div class="grid gap-6">
          {upcomingConcerts.map((concert, index) => (
            <article
              class={`group relative border-2 border-primary rounded-lg overflow-hidden bg-card fade-in-up delay-${Math.min(index + 2, 5)}`}
            >
              <div class="p-8 md:p-10">
                <div class="flex flex-col lg:flex-row lg:items-start gap-8">
                  {/* Date block - large editorial style */}
                  <div class="lg:w-40 flex-shrink-0 text-center lg:text-left">
                    <div class="text-6xl font-serif text-primary leading-none">
                      {concert.data.date.toLocaleDateString('en-US', { day: 'numeric' })}
                    </div>
                    <div class="text-nav text-muted-foreground mt-2">
                      {concert.data.date.toLocaleDateString('en-US', {
                        month: 'long',
                        year: 'numeric',
                      })}
                    </div>
                    <div class="text-sm text-muted-foreground mt-1">
                      {concert.data.date.toLocaleDateString('en-US', { weekday: 'long' })}
                    </div>
                  </div>

                  {/* Content */}
                  <div class="flex-1">
                    <h3 class="text-2xl md:text-3xl font-serif mb-4 group-hover:text-primary transition-colors duration-300">
                      <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                    </h3>

                    <div class="flex flex-wrap gap-4 mb-6 text-sm">
                      <div class="flex items-center gap-2">
                        <svg
                          class="w-4 h-4 text-primary"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                          />
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                          />
                        </svg>
                        <span>
                          {concert.data.venue}, {concert.data.location}
                        </span>
                      </div>
                      <div class="flex items-center gap-2">
                        <svg
                          class="w-4 h-4 text-primary"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"
                          />
                        </svg>
                        <span>{concert.data.orchestra}</span>
                      </div>
                    </div>

                    {concert.data.program && concert.data.program.length > 0 && (
                      <div class="border-t border-border pt-6">
                        <div class="text-nav text-muted-foreground mb-3">Program</div>
                        <ul class="list-none p-0 space-y-2">
                          {concert.data.program.map((piece) => (
                            <li class="flex flex-wrap gap-x-2">
                              <span class="font-medium">{piece.composer}</span>
                              <span class="font-serif italic text-muted-foreground">
                                {piece.work}
                              </span>
                              {piece.soloist && (
                                <span class="text-primary text-sm">({piece.soloist})</span>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </div>
              </div>

              {/* Accent stripe */}
              <div class="h-1 bg-primary" />
            </article>
          ))}
        </div>
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- Featured Past Performances - Showcase Cards -->
  {
    featuredConcerts.length > 0 && (
      <section class="mb-16 fade-in-up delay-2">
        <h2 class="text-nav text-muted-foreground mb-8">Highlights</h2>

        <div class="grid md:grid-cols-3 gap-6">
          {featuredConcerts.map((concert, index) => (
            <article
              class={`group p-6 border border-border rounded-lg bg-card hover:border-primary transition-colors duration-300 fade-in-up delay-${Math.min(index + 3, 5)}`}
            >
              <Badge variant="featured" className="mb-4">
                Featured
              </Badge>
              <div class="text-nav text-muted-foreground mb-2">
                {concert.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
              </div>
              <h3 class="text-lg font-serif mb-3 group-hover:text-primary transition-colors duration-300">
                <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
              </h3>
              <div class="text-sm text-muted-foreground mb-4">
                {concert.data.orchestra}
                <br />
                {concert.data.venue}
              </div>
              <a
                href={`/concerts/${concert.id}`}
                class="text-nav text-primary hover:underline underline-offset-4"
              >
                View Details →
              </a>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- Past Performances Archive -->
  <section class="section fade-in-up delay-3">
    <h2 class="text-nav text-muted-foreground mb-8">Archive</h2>
    {
      years.length === 0 && (
        <EmptyState
          title="No past performances yet"
          message="Check back soon for concert history and archive."
        />
      )
    }
    {
      years.map((year, yearIndex) => (
        <div class={`mb-12 fade-in-up delay-${Math.min(yearIndex + 4, 5)}`}>
          <h3 class="text-4xl font-serif text-primary mb-6 pb-2 border-b-2 border-primary inline-block">
            {year}
          </h3>
          <ul class="list-none p-0">
            {concertsByYear[year].map((concert) => (
              <li class="group flex flex-col md:flex-row gap-4 md:gap-8 list-divider py-5">
                <div class="flex-shrink-0 md:w-20">
                  <span class="text-nav text-muted-foreground">
                    {concert.data.date.toLocaleDateString('en-US', {
                      month: 'short',
                      day: 'numeric',
                    })}
                  </span>
                </div>
                <div class="flex-1">
                  <h4 class="m-0 mb-1 text-lg font-serif group-hover:text-primary transition-colors duration-300">
                    <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                  </h4>
                  <div class="text-sm text-muted-foreground flex flex-wrap gap-x-2">
                    <span>{concert.data.orchestra}</span>
                    <span>·</span>
                    <span>
                      {concert.data.venue}, {concert.data.location}
                    </span>
                  </div>
                  {concert.data.program && concert.data.program.length > 0 && (
                    <div class="text-sm text-muted-foreground mt-2 font-serif italic">
                      {concert.data.program[0].composer}: {concert.data.program[0].work}
                      {concert.data.program.length > 1 && (
                        <span class="not-italic text-primary">
                          {' '}
                          + {concert.data.program.length - 1} more
                        </span>
                      )}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
