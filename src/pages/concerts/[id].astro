---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const concerts = await getCollection('concerts');
  return concerts.map((concert) => ({
    params: { id: concert.id },
    props: { concert },
  }));
}) satisfies GetStaticPaths;

const { concert } = Astro.props;

// Error handling for markdown rendering
let Content;
let renderError = false;
try {
  const rendered = await concert.render();
  Content = rendered.Content;
} catch (error) {
  console.error(`Failed to render concert: ${concert.id}`, error);
  renderError = true;
}
---

<BaseLayout
  title={`${concert.data.title} - Davis Ponjuan`}
  description={`${concert.data.orchestra} - ${concert.data.venue}`}
>
  <article class="max-w-3xl">
    <header class="mb-12 pb-8 border-b-2 border-gray-800">
      <h1 class="text-4xl mb-4">{concert.data.title}</h1>
      <div class="text-gray-600 text-lg">
        <time datetime={concert.data.date.toISOString()}>
          {
            concert.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <span class="mx-2">•</span>
        <span>{concert.data.venue}, {concert.data.location}</span>
        <span class="mx-2">•</span>
        <span>{concert.data.orchestra}</span>
      </div>
    </header>

    {
      concert.data.program && (
        <section class="mb-12">
          <h2 class="text-2xl mb-4 text-[#2d7a3e]">Program</h2>
          <ul class="list-none p-0">
            {concert.data.program.map((piece) => (
              <li class="mb-6 pl-4 border-l-[3px] border-[#2d7a3e]">
                <strong>{piece.composer}</strong>
                <br />
                <em>{piece.work}</em>
                {piece.soloist && (
                  <>
                    <br />
                    <span class="text-gray-600 text-sm">{piece.soloist}</span>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      concert.data.featured && !renderError && (
        <section class="mb-12 leading-relaxed">
          <Content />
        </section>
      )
    }
    {
      renderError && (
        <section class="mb-12 leading-relaxed">
          <p class="text-gray-600 italic">
            Program notes are currently unavailable for this performance.
          </p>
        </section>
      )
    }

    {
      concert.data.media && concert.data.media.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl mb-4 text-[#2d7a3e]">Media</h2>
          <ul class="list-none p-0">
            {concert.data.media.map((item) => (
              <li class="mb-4">
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#2d7a3e] no-underline hover:underline"
                >
                  {item.type === 'video' && '🎥'}
                  {item.type === 'photo' && '📷'}
                  {item.type === 'audio' && '🎵'}
                  {item.caption || item.url}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      concert.data.reviews && concert.data.reviews.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl mb-4 text-[#2d7a3e]">Press Coverage</h2>
          {concert.data.reviews.map((review) => (
            <blockquote class="border-l-4 border-gray-200 pl-6 m-0 mb-8 italic">
              <p class="mb-2 text-lg">{review.excerpt}</p>
              <cite class="not-italic text-sm text-gray-600">
                — <strong>{review.publication}</strong>
                {review.author && `, ${review.author}`}
                {review.url && (
                  <>
                    {' '}
                    •{' '}
                    <a
                      href={review.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[#2d7a3e] no-underline hover:underline"
                    >
                      Read full review
                    </a>
                  </>
                )}
              </cite>
            </blockquote>
          ))}
        </section>
      )
    }

    <nav class="mt-16 pt-8 border-t border-gray-300">
      <a href="/concerts" class="text-[#2d7a3e] no-underline hover:underline"
        >← Back to all concerts</a
      >
    </nav>
  </article>
</BaseLayout>
