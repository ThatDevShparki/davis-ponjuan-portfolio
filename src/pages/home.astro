---
import { getCollection } from 'astro:content';

import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Get featured concerts and upcoming performances
const allConcerts = await getCollection('concerts');
const featuredConcerts = allConcerts
  .filter((concert) => concert.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

// Get featured press for carousel
const allPress = await getCollection('press');
const featuredPress = allPress
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

// Transform press items to carousel format
const pressQuotes = featuredPress.map((item) => ({
  text: item.data.excerpt,
  publication: item.data.publication,
  author: item.data.author,
}));
---

<BaseLayout title="Davis Ponjuan - Conductor">
  <!-- Hero Section - Compact editorial style -->
  <header class="py-12 md:py-16 fade-in relative">
    <!-- Decorative accent line -->
    <div
      class="absolute left-0 top-1/2 -translate-y-1/2 w-0.5 h-20 bg-primary hidden lg:block"
      aria-hidden="true"
    >
    </div>

    <div class="lg:pl-8">
      <p class="text-nav text-primary mb-2 tracking-widest fade-in-up delay-1">Conductor</p>
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-serif leading-[0.95] mb-4 fade-in-up delay-2"
      >
        Davis Ponjuan
      </h1>
      <p class="text-lg md:text-xl text-muted-foreground max-w-lg fade-in-up delay-3">
        Music Director • Educator • Champion of Contemporary Works
      </p>
    </div>
  </header>

  <!-- Featured Press Carousel -->
  {
    pressQuotes.length > 0 && (
      <section class="py-8 md:py-12 bg-muted/30 -mx-6 md:-mx-10 lg:-mx-16 px-6 md:px-10 lg:px-16 fade-in-up delay-4">
        <FeaturedCarousel quotes={pressQuotes} interval={6000} />
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- Two-Column Layout - Tighter grid -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
    <!-- Main Column - Upcoming Performances -->
    <div class="lg:col-span-7">
      {
        upcomingConcerts.length > 0 && (
          <section class="fade-in-up delay-1">
            <div class="flex items-baseline justify-between mb-4">
              <h2 class="text-2xl font-serif">Upcoming</h2>
              <a
                href="/concerts"
                class="text-nav text-primary hover:underline underline-offset-4 transition-all duration-300"
              >
                All Concerts →
              </a>
            </div>

            <div class="divide-y divide-border">
              {upcomingConcerts.map((concert, index) => (
                <article class={`group py-4 first:pt-0 fade-in-up delay-${Math.min(index + 2, 5)}`}>
                  <div class="flex gap-4 md:gap-6">
                    {/* Date block - compact */}
                    <div class="w-14 flex-shrink-0 text-center">
                      <div class="text-2xl font-serif text-primary leading-none">
                        {concert.data.date.toLocaleDateString('en-US', { day: 'numeric' })}
                      </div>
                      <div class="text-[10px] uppercase tracking-wide text-muted-foreground mt-0.5">
                        {concert.data.date.toLocaleDateString('en-US', { month: 'short' })}
                      </div>
                    </div>

                    {/* Content */}
                    <div class="flex-1 min-w-0">
                      <h3 class="text-base md:text-lg font-serif leading-tight group-hover:text-primary transition-colors duration-300">
                        <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                      </h3>
                      <div class="text-sm text-muted-foreground mt-1 truncate">
                        {concert.data.orchestra} · {concert.data.venue}
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <!-- Sidebar Column -->
    <aside class="lg:col-span-5 lg:border-l lg:border-border lg:pl-8">
      <!-- About Snippet -->
      <section class="fade-in-up delay-3">
        <h2 class="text-nav text-muted-foreground mb-3">About</h2>
        <p class="text-base leading-relaxed mb-4">
          Davis Ponjuan is a dynamic conductor known for combining technical precision with deep
          musical insight, bringing fresh perspectives to both standard repertoire and contemporary
          works.
        </p>
        <a
          href="/about"
          class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline underline-offset-4 transition-all duration-300"
        >
          Read full biography
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      </section>

      <hr class="divider-dashed-sm my-6" />

      <!-- Quick Navigation -->
      <nav class="fade-in-up delay-4" aria-label="Quick links">
        <h2 class="text-nav text-muted-foreground mb-3">Explore</h2>
        <ul class="divide-y divide-border">
          {
            [
              { href: '/repertoire', label: 'Repertoire' },
              { href: '/recordings', label: 'Recordings' },
              { href: '/press', label: 'Press & Reviews' },
              { href: '/contact', label: 'Contact' },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center justify-between py-2.5 hover:text-primary transition-colors duration-300"
                >
                  <span class="font-serif">{link.label}</span>
                  <svg
                    class="w-4 h-4 text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 transition-all duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>

  <hr class="divider-dashed" />

  <!-- Featured Performances - Compact Cards -->
  {
    featuredConcerts.length > 0 && (
      <section class="fade-in-up delay-5">
        <div class="flex items-baseline justify-between mb-4">
          <h2 class="text-2xl font-serif">Featured Performances</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-4">
          {featuredConcerts.map((concert, index) => (
            <article
              class={`group p-4 border border-border rounded-md bg-card hover:border-primary transition-all duration-300 fade-in-up delay-${Math.min(index + 1, 5)}`}
            >
              <div class="text-nav text-muted-foreground mb-2">
                {concert.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                })}
              </div>
              <h3 class="text-base font-serif mb-2 leading-tight group-hover:text-primary transition-colors duration-300">
                <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
              </h3>
              <div class="text-xs text-muted-foreground">
                {concert.data.orchestra}
                <br />
                {concert.data.venue}
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
