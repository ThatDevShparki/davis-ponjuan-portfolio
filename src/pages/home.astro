---
import { getCollection } from 'astro:content';

import FeaturedCarousel from '../components/FeaturedCarousel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Get featured concerts and upcoming performances
const allConcerts = await getCollection('concerts');
const featuredConcerts = allConcerts
  .filter((concert) => concert.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcomingConcerts = allConcerts
  .filter((concert) => concert.data.status === 'upcoming')
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

// Get featured press for carousel
const allPress = await getCollection('press');
const featuredPress = allPress
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);

// Transform press items to carousel format
const pressQuotes = featuredPress.map((item) => ({
  text: item.data.excerpt,
  publication: item.data.publication,
  author: item.data.author,
}));

// Get featured recording
const allRecordings = await getCollection('recordings');
const featuredRecording = allRecordings.find((r) => r.data.featured);

// Helper to get cover image src
function getCoverImageSrc(coverImage: string | { src: string } | undefined): string | undefined {
  if (!coverImage) return undefined;
  if (typeof coverImage === 'string') return coverImage;
  return coverImage.src;
}
---

<BaseLayout title="Davis Ponjuán - Conductor">
  <!-- Hero Section with Image - Full Width, extends behind floating navbar -->
  <header
    class="relative mb-8 md:mb-10 fade-in -mt-20 md:-mt-28"
    style="width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);"
  >
    <!-- Image Container - responsive height for different devices -->
    <div class="relative h-[30vh] min-h-[200px] md:h-[40vh] lg:h-[45vh] overflow-hidden">
      <img
        src="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=1200&q=80&auto=format"
        srcset="https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=640&q=80&auto=format 640w,
                https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=1200&q=80&auto=format 1200w,
                https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?w=1920&q=80&auto=format 1920w"
        sizes="100vw"
        alt="Davis Ponjuán conducting"
        class="w-full h-full object-cover object-[center_30%]"
        width="1920"
        height="1280"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <!-- Subtle gradient at bottom for blend -->
      <div
        class="absolute inset-x-0 bottom-0 h-16 md:h-24 bg-gradient-to-t from-background to-transparent"
      >
      </div>
    </div>

    <!-- Hero Content - Below image for better contrast -->
    <div class="bg-background pt-6 pb-4 md:pt-10 md:pb-6">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16">
        <p
          class="text-[10px] md:text-xs text-primary mb-3 md:mb-4 tracking-[0.25em] uppercase font-medium fade-in-up delay-1"
        >
          Conductor
        </p>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-serif leading-[0.9] tracking-[-0.03em] mb-4 md:mb-5 fade-in-up delay-2"
        >
          Davis Ponjuán
        </h1>
        <p class="text-sm md:text-base text-muted-foreground tracking-wide fade-in-up delay-3">
          Conductor · Musician · Educator
        </p>
      </div>
    </div>
  </header>

  <hr class="divider-dashed" />

  <!-- Two-Column Layout -->
  <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
    <!-- Main Column - Upcoming Performances -->
    <div class="lg:col-span-7">
      {
        upcomingConcerts.length > 0 && (
          <section class="fade-in-up delay-1">
            <div class="flex items-baseline justify-between mb-6">
              <h2 class="text-3xl md:text-4xl font-serif tracking-tight">Upcoming</h2>
              <a
                href="/concerts"
                class="text-nav text-primary hover:underline underline-offset-4 transition-all duration-300"
              >
                All Concerts →
              </a>
            </div>

            <div class="divide-y divide-border">
              {upcomingConcerts.map((concert, index) => (
                <article class={`group py-4 first:pt-0 fade-in-up delay-${Math.min(index + 2, 5)}`}>
                  <div class="flex gap-4 md:gap-6">
                    {/* Date block */}
                    <div class="w-16 md:w-20 flex-shrink-0 text-center">
                      <div class="text-3xl md:text-4xl font-serif text-primary leading-none tracking-tight">
                        {concert.data.date.toLocaleDateString('en-US', { day: 'numeric' })}
                      </div>
                      <div class="text-[10px] uppercase tracking-[0.15em] text-muted-foreground mt-1">
                        {concert.data.date.toLocaleDateString('en-US', { month: 'short' })}
                      </div>
                    </div>

                    {/* Content */}
                    <div class="flex-1 min-w-0">
                      <h3 class="text-base md:text-lg font-serif leading-tight group-hover:text-primary transition-colors duration-300">
                        <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                      </h3>
                      <div class="text-sm text-muted-foreground mt-1 truncate">
                        {concert.data.orchestra} · {concert.data.venue}
                      </div>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <!-- Sidebar Column -->
    <aside class="lg:col-span-5 lg:border-l lg:border-border lg:pl-8">
      <!-- About Snippet -->
      <section class="fade-in-up delay-3">
        <h2 class="text-nav text-muted-foreground mb-3">About</h2>
        <p class="text-base leading-relaxed mb-4">
          Davis Ponjuán is a dynamic conductor known for combining technical precision with deep
          musical insight, bringing fresh perspectives to both standard repertoire and contemporary
          works.
        </p>
        <a
          href="/about"
          class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline underline-offset-4 transition-all duration-300"
        >
          Read biography
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"
            ></path>
          </svg>
        </a>
      </section>

      <hr class="divider-dashed-sm my-6" />

      <!-- Quick Navigation -->
      <nav class="fade-in-up delay-4" aria-label="Quick links">
        <h2 class="text-nav text-muted-foreground mb-3">Explore</h2>
        <ul class="divide-y divide-border">
          {
            [
              { href: '/repertoire', label: 'Repertoire' },
              { href: '/recordings', label: 'Recordings' },
              { href: '/press', label: 'Press & Reviews' },
              { href: '/contact', label: 'Contact' },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group flex items-center justify-between py-2.5 hover:text-primary transition-colors duration-300"
                >
                  <span class="font-serif">{link.label}</span>
                  <svg
                    class="w-4 h-4 text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 transition-all duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
  </div>

  <hr class="divider-dashed" />

  <!-- Featured Performances with Images -->
  {
    featuredConcerts.length > 0 && (
      <section class="fade-in-up delay-5">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="text-3xl md:text-4xl font-serif tracking-tight">Featured Performances</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {featuredConcerts.map((concert, index) => {
            const coverSrc = getCoverImageSrc(concert.data.coverImage);
            return (
              <article
                class={`group overflow-hidden rounded-md border border-border bg-card hover:border-primary transition-all duration-300 fade-in-up delay-${Math.min(index + 1, 5)}`}
              >
                {/* Cover Image */}
                {coverSrc && (
                  <a href={`/concerts/${concert.id}`} class="block overflow-hidden">
                    <img
                      src={coverSrc}
                      alt={concert.data.title}
                      class="w-full aspect-[16/10] object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                  </a>
                )}

                <div class="p-4">
                  <div class="text-nav text-muted-foreground mb-2">
                    {concert.data.date.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </div>
                  <h3 class="text-base font-serif mb-2 leading-tight group-hover:text-primary transition-colors duration-300">
                    <a href={`/concerts/${concert.id}`}>{concert.data.title}</a>
                  </h3>
                  <div class="text-xs text-muted-foreground">
                    {concert.data.orchestra}
                    <br />
                    {concert.data.venue}
                  </div>

                  {/* Show first video if available */}
                  {concert.data.videos && concert.data.videos.length > 0 && (
                    <a
                      href={concert.data.videos[0].src}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 mt-3 text-xs text-primary hover:underline"
                    >
                      <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                      Watch Performance
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- Featured Recording -->
  {
    featuredRecording && (
      <section class="mt-10 fade-in-up delay-5">
        <div class="flex items-baseline justify-between mb-8">
          <h2 class="text-3xl md:text-4xl font-serif tracking-tight">Latest Recording</h2>
          <a
            href="/recordings"
            class="text-nav text-primary hover:underline underline-offset-4 transition-all duration-300"
          >
            All Recordings →
          </a>
        </div>

        <div class="grid md:grid-cols-12 gap-6 p-5 md:p-6 border border-primary rounded-md bg-card">
          {/* Album Art */}
          {getCoverImageSrc(featuredRecording.data.coverImage) && (
            <div class="md:col-span-4 lg:col-span-3">
              <img
                src={getCoverImageSrc(featuredRecording.data.coverImage)}
                alt={featuredRecording.data.title}
                class="w-full aspect-square object-cover rounded-md shadow-lg"
                loading="lazy"
              />
            </div>
          )}

          {/* Recording Info */}
          <div class="md:col-span-8 lg:col-span-9">
            <h3 class="text-xl font-serif mb-2">{featuredRecording.data.title}</h3>

            <div class="text-sm text-muted-foreground mb-3">
              {featuredRecording.data.orchestra} · {featuredRecording.data.label} ·{' '}
              {featuredRecording.data.releaseDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
              })}
            </div>

            {featuredRecording.data.works && featuredRecording.data.works.length > 0 && (
              <div class="text-sm font-serif italic text-muted-foreground mb-4">
                {featuredRecording.data.works.join(' · ')}
              </div>
            )}

            {featuredRecording.data.awards && featuredRecording.data.awards.length > 0 && (
              <div class="mb-4 py-2 px-3 bg-primary/5 border-l-2 border-primary text-xs inline-block">
                {featuredRecording.data.awards.map((award: string) => (
                  <div class="text-primary font-medium">{award}</div>
                ))}
              </div>
            )}

            {/* Streaming Links */}
            {featuredRecording.data.externalLinks &&
              featuredRecording.data.externalLinks.length > 0 && (
                <div class="flex flex-wrap gap-2">
                  {featuredRecording.data.externalLinks.slice(0, 3).map((link) => (
                    <a
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs bg-muted hover:bg-primary hover:text-primary-foreground rounded-md transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              )}
          </div>
        </div>
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- Featured Press Carousel -->
  {
    pressQuotes.length > 0 && (
      <section class="py-8 md:py-12 bg-muted/30 -mx-6 md:-mx-10 lg:-mx-16 px-6 md:px-10 lg:px-16 mt-10 fade-in-up delay-5">
        <FeaturedCarousel quotes={pressQuotes} interval={6000} />
      </section>
    )
  }
</BaseLayout>
