---
import { getCollection } from 'astro:content';

import { Button } from '@/components/ui/button';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const currentPositions = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const featuredAwards = allAwards
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<BaseLayout title="About - Davis Ponjuan" description="Biography of conductor Davis Ponjuan">
  <header class="section fade-in">
    <h1 class="mb-6">About</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      A dynamic conductor known for combining technical precision with deep musical insight.
    </p>
  </header>

  <hr class="divider-dashed" />

  <!-- TODO: Add your biography content here before going live -->
  <section class="section fade-in-up delay-1">
    <h2 class="section-heading">Biography</h2>
    <div class="space-y-6 text-lg leading-relaxed max-w-3xl">
      <p>
        Davis Ponjuan is a dynamic conductor known for combining technical precision with deep
        musical insight. Currently serving as Music Director of the Metro City Symphony Orchestra,
        he has built a reputation for bringing fresh perspectives to both standard repertoire and
        contemporary works.
      </p>
      <p>
        With a background that spans from violin performance to orchestral conducting, Davis brings
        a unique understanding of both the podium and the performer's perspective. His approach
        emphasizes collaboration, clarity of gesture, and a commitment to making classical music
        accessible and engaging for diverse audiences.
      </p>
    </div>
  </section>

  <hr class="divider-dashed-sm" />

  <section class="section-sm fade-in-up delay-2">
    <h2 class="section-heading-sm">Current Positions</h2>
    <ul class="list-none p-0 space-y-4">
      {
        currentPositions.map((org) => (
          <li class="flex flex-col md:flex-row md:gap-4">
            <span class="font-semibold text-lg">{org.data.role}</span>
            <span class="text-muted-foreground">{org.data.name}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section-sm fade-in-up delay-3">
    <h2 class="section-heading-sm">Education</h2>
    <ul class="list-none p-0 space-y-4">
      {
        sortedEducation.map((edu) => (
          <li class="flex flex-col md:flex-row md:items-baseline md:gap-4">
            <span class="font-semibold">
              {edu.data.degree} in {edu.data.field}
            </span>
            <span class="text-muted-foreground text-sm">
              {edu.data.institution},{' '}
              {edu.data.endDate
                ? edu.data.endDate.toLocaleDateString('en-US', { year: 'numeric' })
                : 'In Progress'}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section-sm fade-in-up delay-4">
    <h2 class="section-heading-sm">Awards & Honors</h2>
    <ul class="list-none p-0 space-y-4">
      {
        featuredAwards.map((award) => (
          <li class="flex flex-col md:flex-row md:items-baseline md:gap-4">
            <span class="font-semibold">{award.data.title}</span>
            <span class="text-muted-foreground text-sm">
              {award.data.organization},{' '}
              {award.data.date.toLocaleDateString('en-US', { year: 'numeric' })}
            </span>
          </li>
        ))
      }
    </ul>
    <div class="mt-6">
      <a
        href="/cv"
        class="text-primary hover:underline underline-offset-4 transition-all duration-300"
      >
        View complete awards list →
      </a>
    </div>
  </section>

  <hr class="divider-dashed" />

  <nav class="flex flex-col sm:flex-row gap-4 fade-in-up delay-5">
    <Button asChild size="xl">
      <a href="/cv">View Full CV</a>
    </Button>
    <Button asChild variant="outline" size="xl">
      <a href="/concerts">View Performances</a>
    </Button>
  </nav>
</BaseLayout>
