---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const currentPositions = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const featuredAwards = allAwards
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<BaseLayout title="About - Davis Ponjuan" description="Biography of conductor Davis Ponjuan">
  <h1 class="text-5xl mb-8">About Davis Ponjuan</h1>

  <!-- TODO: Add your biography content here before going live -->
  <section class="mb-12">
    <h2 class="text-2xl mt-12 mb-4 border-b border-gray-300 pb-2">Biography</h2>
    <p>
      Davis Ponjuan is a dynamic conductor known for combining technical precision with deep musical
      insight. Currently serving as Music Director of the Metro City Symphony Orchestra, he has
      built a reputation for bringing fresh perspectives to both standard repertoire and
      contemporary works.
    </p>
    <p>
      With a background that spans from violin performance to orchestral conducting, Davis brings a
      unique understanding of both the podium and the performer's perspective. His approach
      emphasizes collaboration, clarity of gesture, and a commitment to making classical music
      accessible and engaging for diverse audiences.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl mt-12 mb-4 border-b border-gray-300 pb-2">Current Positions</h2>
    <ul class="list-disc pl-8">
      {
        currentPositions.map((org) => (
          <li class="mb-2">
            <strong>{org.data.role}</strong>, {org.data.name}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl mt-12 mb-4 border-b border-gray-300 pb-2">Education</h2>
    <ul class="list-disc pl-8">
      {
        sortedEducation.map((edu) => (
          <li class="mb-2">
            <strong>{edu.data.degree}</strong> in {edu.data.field}, {edu.data.institution} (
            {edu.data.endDate
              ? edu.data.endDate.toLocaleDateString('en-US', { year: 'numeric' })
              : 'In Progress'}
            )
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-12">
    <h2 class="text-2xl mt-12 mb-4 border-b border-gray-300 pb-2">Awards & Honors</h2>
    <ul class="list-disc pl-8">
      {
        featuredAwards.map((award) => (
          <li class="mb-2">
            <strong>{award.data.title}</strong>, {award.data.organization} (
            {award.data.date.toLocaleDateString('en-US', { year: 'numeric' })})
          </li>
        ))
      }
    </ul>
    <a href="/cv" class="text-[#2d7a3e] no-underline hover:underline">View complete awards list →</a
    >
  </section>

  <nav class="mt-12 flex gap-8">
    <a
      href="/cv"
      class="inline-block py-3 px-6 bg-[#2d7a3e] text-white no-underline rounded hover:bg-[#246330]"
      >View Full CV →</a
    >
    <a
      href="/concerts"
      class="inline-block py-3 px-6 bg-[#2d7a3e] text-white no-underline rounded hover:bg-[#246330]"
      >View Performances →</a
    >
  </nav>
</BaseLayout>
