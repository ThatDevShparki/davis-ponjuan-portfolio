---
import { getCollection } from 'astro:content';

import { Button } from '@/components/ui/button';

import BaseLayout from '../layouts/BaseLayout.astro';

const allOrganizations = await getCollection('organizations');
const currentPositions = allOrganizations
  .filter((org) => org.data.type === 'current')
  .sort((a, b) => a.data.order - b.data.order);

const allEducation = await getCollection('education');
const sortedEducation = allEducation.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

const allAwards = await getCollection('awards');
const featuredAwards = allAwards
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
---

<BaseLayout title="About - Davis Ponjuán" description="Biography of conductor Davis Ponjuán">
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">About</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      A dynamic conductor known for combining technical precision with deep musical insight.
    </p>
  </header>

  <hr class="divider-dashed" />

  <!-- Biography -->
  <section class="mb-10 fade-in-up delay-1">
    <h2 class="text-nav text-muted-foreground mb-4">Biography</h2>
    <div class="space-y-4 text-base leading-relaxed max-w-2xl">
      <p>
        Davis Ponjuán is a dynamic conductor known for combining technical precision with deep
        musical insight. Currently serving as Music Director of the Metro City Symphony Orchestra,
        he has built a reputation for bringing fresh perspectives to both standard repertoire and
        contemporary works.
      </p>
      <p>
        With a background that spans from violin performance to orchestral conducting, Davis brings
        a unique understanding of both the podium and the performer's perspective. His approach
        emphasizes collaboration, clarity of gesture, and a commitment to making classical music
        accessible and engaging for diverse audiences.
      </p>
    </div>
  </section>

  <!-- Two Column Layout for Quick Facts -->
  <div class="grid lg:grid-cols-2 gap-8 mb-10">
    <section class="fade-in-up delay-2">
      <h2 class="text-nav text-muted-foreground mb-3">Current Positions</h2>
      <ul class="divide-y divide-border">
        {
          currentPositions.map((org) => (
            <li class="py-2.5 first:pt-0">
              <div class="font-serif">{org.data.role}</div>
              <div class="text-sm text-muted-foreground">{org.data.name}</div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="fade-in-up delay-3">
      <h2 class="text-nav text-muted-foreground mb-3">Education</h2>
      <ul class="divide-y divide-border">
        {
          sortedEducation.map((edu) => (
            <li class="py-2.5 first:pt-0">
              <div class="font-serif">
                {edu.data.degree} in {edu.data.field}
              </div>
              <div class="text-sm text-muted-foreground">
                {edu.data.institution},{' '}
                {edu.data.endDate
                  ? edu.data.endDate.toLocaleDateString('en-US', { year: 'numeric' })
                  : 'In Progress'}
              </div>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <section class="mb-10 fade-in-up delay-4">
    <div class="flex items-baseline justify-between mb-3">
      <h2 class="text-nav text-muted-foreground">Awards & Honors</h2>
      <a
        href="/cv"
        class="text-nav text-primary hover:underline underline-offset-4 transition-all duration-300"
      >
        View all →
      </a>
    </div>
    <ul class="divide-y divide-border">
      {
        featuredAwards.map((award) => (
          <li class="py-2.5 first:pt-0 flex flex-col md:flex-row md:items-baseline md:gap-3">
            <span class="font-serif">{award.data.title}</span>
            <span class="text-xs text-muted-foreground">
              {award.data.organization},{' '}
              {award.data.date.toLocaleDateString('en-US', { year: 'numeric' })}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <hr class="divider-dashed" />

  <nav class="flex flex-wrap gap-3 fade-in-up delay-5">
    <Button asChild>
      <a href="/cv">View Full CV</a>
    </Button>
    <Button asChild variant="outline">
      <a href="/concerts">View Performances</a>
    </Button>
  </nav>
</BaseLayout>
