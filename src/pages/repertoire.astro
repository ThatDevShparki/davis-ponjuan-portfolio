---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allRepertoire = await getCollection('repertoire');

// Group by genre
const byGenre = allRepertoire.reduce(
  (acc, work) => {
    if (!acc[work.data.genre]) {
      acc[work.data.genre] = [];
    }
    acc[work.data.genre].push(work);
    return acc;
  },
  {} as Record<string, typeof allRepertoire>
);

// Sort works within each genre alphabetically by composer
Object.keys(byGenre).forEach((genre) => {
  byGenre[genre].sort((a, b) => {
    const composerCompare = a.data.composer.localeCompare(b.data.composer);
    if (composerCompare !== 0) return composerCompare;
    return a.data.work.localeCompare(b.data.work);
  });
});

const genreOrder = [
  'symphonic',
  'operatic',
  'contemporary',
  'chamber',
  'choral',
  'ballet',
  'other',
];
const genres = genreOrder.filter((genre) => byGenre[genre]);

const genreLabels: Record<string, string> = {
  symphonic: 'Symphonic',
  operatic: 'Operatic',
  contemporary: 'Contemporary',
  chamber: 'Chamber',
  choral: 'Choral',
  ballet: 'Ballet',
  other: 'Other',
};
---

<BaseLayout title="Repertoire - Davis Ponjuan" description="Complete list of works conducted">
  <header class="section fade-in">
    <h1 class="mb-6">Repertoire</h1>
    <p class="text-xl leading-relaxed text-muted-foreground max-w-3xl">
      A selection of works conducted throughout my career, organized by genre.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    genres.map((genre, index) => (
      <section class={`section fade-in-up delay-${Math.min(index + 1, 5)}`}>
        <h2 class="text-3xl font-serif text-primary border-b-2 border-primary pb-2 mb-8">
          {genreLabels[genre]}
        </h2>
        <ul class="list-none p-0">
          {byGenre[genre].map((work) => (
            <li class="list-divider py-5">
              <div class="text-lg font-semibold">{work.data.composer}</div>
              <div class="mt-1 text-base font-serif italic">{work.data.work}</div>
              <div class="metadata mt-2 flex flex-wrap gap-x-1">
                <span>
                  Performed {work.data.timesPerformed}{' '}
                  {work.data.timesPerformed === 1 ? 'time' : 'times'}
                </span>
                {work.data.firstPerformed && (
                  <>
                    <span class="metadata-separator" />
                    <span>
                      First:{' '}
                      {work.data.firstPerformed.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                      })}
                    </span>
                  </>
                )}
                {work.data.lastPerformed && (
                  <>
                    <span class="metadata-separator" />
                    <span>
                      Most recent:{' '}
                      {work.data.lastPerformed.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                      })}
                    </span>
                  </>
                )}
              </div>
              {work.data.notes && (
                <div class="mt-2 text-sm text-muted-foreground italic">{work.data.notes}</div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
