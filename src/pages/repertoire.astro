---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allRepertoire = await getCollection('repertoire');

// Group by genre
const byGenre = allRepertoire.reduce(
  (acc, work) => {
    if (!acc[work.data.genre]) {
      acc[work.data.genre] = [];
    }
    acc[work.data.genre].push(work);
    return acc;
  },
  {} as Record<string, typeof allRepertoire>
);

// Sort works within each genre alphabetically by composer
Object.keys(byGenre).forEach((genre) => {
  byGenre[genre].sort((a, b) => {
    const composerCompare = a.data.composer.localeCompare(b.data.composer);
    if (composerCompare !== 0) return composerCompare;
    return a.data.work.localeCompare(b.data.work);
  });
});

const genreOrder = [
  'symphonic',
  'operatic',
  'contemporary',
  'chamber',
  'choral',
  'ballet',
  'other',
];
const genres = genreOrder.filter((genre) => byGenre[genre]);

const genreLabels: Record<string, string> = {
  symphonic: 'Symphonic',
  operatic: 'Operatic',
  contemporary: 'Contemporary',
  chamber: 'Chamber',
  choral: 'Choral',
  ballet: 'Ballet',
  other: 'Other',
};
---

<BaseLayout title="Repertoire - Davis Ponjuán" description="Complete list of works conducted">
  <header class="mb-6 md:mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Repertoire</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Works conducted across symphonic, operatic, and contemporary repertoire.
    </p>
  </header>

  <hr class="divider-dashed" />

  {
    genres.map((genre, index) => (
      <section class={`mb-10 fade-in-up delay-${Math.min(index + 1, 5)}`}>
        <h2 class="text-xl font-serif text-primary mb-4 pb-1 border-b border-primary inline-block">
          {genreLabels[genre]}
        </h2>
        <ul class="divide-y divide-border">
          {byGenre[genre].map((work) => (
            <li class="py-3 first:pt-0">
              <div class="flex flex-col md:flex-row md:items-baseline md:gap-3">
                <span class="font-medium">{work.data.composer}</span>
                <span class="font-serif italic text-muted-foreground">{work.data.work}</span>
              </div>
              <div class="text-xs text-muted-foreground mt-1 flex flex-wrap gap-x-3">
                <span>
                  Performed {work.data.timesPerformed}{' '}
                  {work.data.timesPerformed === 1 ? 'time' : 'times'}
                </span>
                {work.data.firstPerformed && (
                  <span>
                    First:{' '}
                    {work.data.firstPerformed.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </span>
                )}
                {work.data.lastPerformed && (
                  <span>
                    Recent:{' '}
                    {work.data.lastPerformed.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'short',
                    })}
                  </span>
                )}
              </div>
              {work.data.notes && (
                <div class="mt-1 text-xs text-muted-foreground italic">{work.data.notes}</div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
