---
/**
 * COMING SOON LANDING PAGE
 *
 * To remove this landing page and launch the site:
 * 1. Delete this file (src/pages/index.astro)
 * 2. Rename src/pages/home.astro to src/pages/index.astro
 * 3. Update BaseLayout.astro navigation to change "/home" back to "/"
 *
 * Hidden access: Click bottom-right corner to access the real site at /home
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Davis Ponjuan - Conductor" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Davis Ponjuan - Conductor</title>
  </head>
  <body>
    <main class="coming-soon">
      <div class="content">
        <h1>Davis Ponjuan</h1>
        <p class="subtitle">Conductor</p>
        <p class="message">Website coming soon.</p>
      </div>

      <!-- Hidden access button -->
      <a href="/home" class="secret-access" aria-label="Access site"></a>
    </main>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    background: #fefbf5;
    color: #242424;
    min-height: 100vh;
  }

  .coming-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 2rem;
    position: relative;
  }

  .content {
    text-align: center;
    max-width: 600px;
  }

  h1 {
    font-size: clamp(2.5rem, 8vw, 4rem);
    font-weight: 400;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    color: #666;
    margin-bottom: 3rem;
    font-weight: 300;
  }

  .message {
    font-size: clamp(1rem, 3vw, 1.25rem);
    color: #666;
    font-weight: 300;
  }

  /* Hidden access button in bottom right */
  .secret-access {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 80px;
    height: 80px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .secret-access:hover {
    opacity: 0.05;
  }

  /* Print styles - hide everything for print */
  @media print {
    body {
      display: none;
    }
  }
</style>
