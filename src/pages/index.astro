---
/**
 * COMING SOON LANDING PAGE
 *
 * To remove this landing page and launch the site:
 * 1. Delete this file (src/pages/index.astro)
 * 2. Rename src/pages/home.astro to src/pages/index.astro
 * 3. Update BaseLayout.astro navigation to change "/home" back to "/"
 *
 * Hidden access: Click bottom-right corner to access the real site at /home
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Davis Ponjuan - Conductor" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Davis Ponjuan - Conductor</title>
  </head>
  <body class="bg-background text-foreground min-h-screen font-sans print-hidden">
    <main class="flex items-center justify-center min-h-screen p-8 relative">
      <div class="text-center max-w-2xl">
        <h1 class="text-[clamp(2.5rem,8vw,4rem)] font-normal mb-2 tracking-tight">Davis Ponjuan</h1>
        <p class="text-[clamp(1.25rem,4vw,1.75rem)] text-muted-foreground mb-12 font-light">
          Conductor
        </p>
        <p class="text-[clamp(1rem,3vw,1.25rem)] text-muted-foreground font-light">
          Website coming soon.
        </p>
      </div>

      <!-- Hidden access button -->
      <a
        href="/home"
        class="fixed bottom-0 right-0 w-20 h-20 cursor-pointer opacity-0 hover:opacity-5 transition-opacity duration-300"
        aria-label="Access site"></a>
    </main>
  </body>
</html>
