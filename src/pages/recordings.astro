---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';

const allRecordings = await getCollection('recordings');
const sortedRecordings = allRecordings.sort(
  (a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime()
);
---

<BaseLayout title="Recordings - Davis Ponjuan" description="Discography and recordings">
  <h1 class="text-5xl mb-8">Recordings</h1>

  <section class="grid gap-12">
    {
      sortedRecordings.map(async (recording) => {
        const { Content } = await recording.render();
        return (
          <article class="border border-gray-300 rounded-lg p-8 bg-gray-50">
            <div class="flex items-center gap-4 mb-6 pb-4 border-b-2 border-[#2d7a3e]">
              <h2 class="text-3xl m-0 flex-1">{recording.data.title}</h2>
              {recording.data.featured && (
                <span class="inline-block bg-[#2d7a3e] text-white py-1 px-3 text-xs rounded font-normal">
                  Featured
                </span>
              )}
            </div>

            <div class="mb-6">
              <div class="mb-2 text-gray-800">
                <strong class="text-gray-600 mr-2">Orchestra:</strong> {recording.data.orchestra}
              </div>
              <div class="mb-2 text-gray-800">
                <strong class="text-gray-600 mr-2">Label:</strong> {recording.data.label}
              </div>
              <div class="mb-2 text-gray-800">
                <strong class="text-gray-600 mr-2">Released:</strong>{' '}
                {recording.data.releaseDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                })}
              </div>
              <div class="mb-2 text-gray-800">
                <strong class="text-gray-600 mr-2">Format:</strong>{' '}
                {recording.data.format.join(', ')}
              </div>
              {recording.data.catalogNumber && (
                <div class="mb-2 text-gray-800">
                  <strong class="text-gray-600 mr-2">Catalog:</strong>{' '}
                  {recording.data.catalogNumber}
                </div>
              )}
            </div>

            {recording.data.works && recording.data.works.length > 0 && (
              <div class="mb-6">
                <strong>Works:</strong>
                <ul class="list-none p-0 mt-2">
                  {recording.data.works.map((work) => (
                    <li class="pl-4 mb-1 relative before:content-['•'] before:absolute before:left-0 before:text-[#2d7a3e]">
                      {work}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {recording.data.awards && recording.data.awards.length > 0 && (
              <div class="mb-6 p-4 bg-white border-l-[3px] border-[#2d7a3e]">
                {recording.data.awards.map((award) => (
                  <div class="text-[#2d7a3e] font-semibold text-[0.95rem] mb-2 last:mb-0">
                    {award}
                  </div>
                ))}
              </div>
            )}

            <div class="leading-relaxed mb-6">
              <Content />
            </div>

            <div class="flex gap-4 flex-wrap">
              {recording.data.purchaseUrl && (
                <a
                  href={recording.data.purchaseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block py-3 px-6 no-underline rounded font-semibold transition-colors bg-[#2d7a3e] text-white hover:bg-[#246330]"
                >
                  Purchase
                </a>
              )}
              {recording.data.streamingUrl && (
                <a
                  href={recording.data.streamingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block py-3 px-6 no-underline rounded font-semibold transition-colors bg-white text-[#2d7a3e] border-2 border-[#2d7a3e] hover:bg-gray-100"
                >
                  Listen
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </section>
</BaseLayout>
