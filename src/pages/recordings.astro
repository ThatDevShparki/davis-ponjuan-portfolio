---
import { getCollection } from 'astro:content';

import { Badge } from '@/components/ui/badge';

import MediaLinks from '../components/media/MediaLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const allRecordings = await getCollection('recordings');

// Separate featured and regular recordings
const featuredRecordings = allRecordings
  .filter((r) => r.data.featured)
  .sort((a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime());

const otherRecordings = allRecordings
  .filter((r) => !r.data.featured)
  .sort((a, b) => b.data.releaseDate.getTime() - a.data.releaseDate.getTime());

// Helper to get cover image src
function getCoverImageSrc(coverImage: string | { src: string } | undefined): string | undefined {
  if (!coverImage) return undefined;
  if (typeof coverImage === 'string') return coverImage;
  return coverImage.src;
}
---

<BaseLayout title="Recordings - Davis Ponjuán" description="Discography and recordings">
  <header class="mb-8 fade-in">
    <h1 class="text-4xl md:text-5xl mb-3">Recordings</h1>
    <p class="text-lg text-muted-foreground max-w-2xl">
      Discography and selected recordings from throughout my career.
    </p>
  </header>

  <div class="flex items-center justify-between mb-8 fade-in-up delay-1">
    <hr class="divider-dashed flex-1 my-0" />
    <!-- Role Filter -->
    <nav class="ml-6 flex-shrink-0" aria-label="Filter by role">
      <ul class="flex gap-3 text-sm" id="role-filter">
        <li>
          <button
            type="button"
            data-filter="all"
            class="filter-btn text-foreground border-b border-primary pb-0.5"
          >
            All
          </button>
        </li>
        <li>
          <button
            type="button"
            data-filter="conductor"
            class="filter-btn text-muted-foreground hover:text-foreground transition-colors"
          >
            Conducting
          </button>
        </li>
        <li>
          <button
            type="button"
            data-filter="musician"
            class="filter-btn text-muted-foreground hover:text-foreground transition-colors"
          >
            Performing
          </button>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Featured Recordings -->
  {
    featuredRecordings.length > 0 && (
      <section class="mb-10 fade-in-up delay-1">
        <h2 class="text-nav text-muted-foreground mb-4">Featured Recordings</h2>

        <div class="space-y-6">
          {featuredRecordings.map((recording, index) => {
            const coverSrc = getCoverImageSrc(recording.data.coverImage);
            return (
              <article
                class={`recording-item group relative border border-primary rounded-md overflow-hidden bg-card fade-in-up delay-${Math.min(index + 2, 5)}`}
                data-role={recording.data.role || 'conductor'}
              >
                <div class="grid md:grid-cols-12 gap-0">
                  {/* Album Art */}
                  {coverSrc && (
                    <div class="md:col-span-4 lg:col-span-3">
                      <img
                        src={coverSrc}
                        alt={recording.data.title}
                        class="w-full aspect-square object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* Content */}
                  <div
                    class={`p-5 md:p-6 ${coverSrc ? 'md:col-span-8 lg:col-span-9' : 'md:col-span-12'}`}
                  >
                    <div class="flex flex-wrap items-center gap-2 mb-3">
                      <Badge variant="featured" className="text-[10px]">
                        Featured
                      </Badge>
                      <span
                        class:list={[
                          'px-2 py-0.5 rounded text-[10px] font-medium capitalize',
                          recording.data.role === 'conductor'
                            ? 'bg-primary/10 text-primary'
                            : 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
                        ]}
                      >
                        {recording.data.role || 'Conductor'}
                      </span>
                    </div>

                    <h3 class="text-xl font-serif mb-3">{recording.data.title}</h3>

                    <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
                      <div>
                        <span class="text-muted-foreground">Orchestra:</span>{' '}
                        {recording.data.orchestra}
                      </div>
                      <div>
                        <span class="text-muted-foreground">Label:</span> {recording.data.label}
                      </div>
                      <div>
                        <span class="text-muted-foreground">Released:</span>{' '}
                        {recording.data.releaseDate.toLocaleDateString('en-US', {
                          year: 'numeric',
                          month: 'short',
                        })}
                      </div>
                      <div>
                        <span class="text-muted-foreground">Format:</span>{' '}
                        {recording.data.format.join(', ')}
                      </div>
                    </div>

                    {recording.data.works && recording.data.works.length > 0 && (
                      <div class="mb-3 text-sm font-serif italic text-muted-foreground line-clamp-2">
                        {recording.data.works.join(' · ')}
                      </div>
                    )}

                    {recording.data.awards && recording.data.awards.length > 0 && (
                      <div class="mb-4 py-2 px-3 bg-primary/5 border-l-2 border-primary text-xs">
                        {recording.data.awards.map((award: string) => (
                          <div class="text-primary font-medium">{award}</div>
                        ))}
                      </div>
                    )}

                    {/* Streaming/Purchase Links */}
                    {recording.data.externalLinks && recording.data.externalLinks.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {recording.data.externalLinks.slice(0, 4).map((link) => (
                          <a
                            href={link.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs bg-muted hover:bg-primary hover:text-primary-foreground rounded-md transition-colors duration-300"
                          >
                            {link.label}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <hr class="divider-dashed" />

  <!-- All Other Recordings -->
  {
    otherRecordings.length > 0 && (
      <section class="fade-in-up delay-3">
        <h2 class="text-nav text-muted-foreground mb-4">Discography</h2>

        <div class="divide-y divide-border">
          {otherRecordings.map((recording, index) => {
            const coverSrc = getCoverImageSrc(recording.data.coverImage);
            return (
              <article
                class={`recording-item group py-5 first:pt-0 fade-in-up delay-${Math.min(index + 4, 5)}`}
                data-role={recording.data.role || 'conductor'}
              >
                <div class="flex gap-4 md:gap-6">
                  {/* Album Art Thumbnail */}
                  {coverSrc && (
                    <div class="w-20 h-20 md:w-24 md:h-24 flex-shrink-0 rounded-md overflow-hidden bg-muted">
                      <img
                        src={coverSrc}
                        alt={recording.data.title}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* If no cover, show year */}
                  {!coverSrc && (
                    <div class="w-16 flex-shrink-0 text-center">
                      <div class="text-2xl font-serif text-primary">
                        {recording.data.releaseDate.getFullYear()}
                      </div>
                      <div class="text-[10px] uppercase tracking-wide text-muted-foreground">
                        {recording.data.releaseDate.toLocaleDateString('en-US', { month: 'short' })}
                      </div>
                    </div>
                  )}

                  {/* Content */}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 mb-1">
                      <h3 class="text-lg font-serif group-hover:text-primary transition-colors duration-300">
                        {recording.data.title}
                      </h3>
                      <span
                        class:list={[
                          'px-1.5 py-0.5 rounded text-[10px] font-medium capitalize flex-shrink-0',
                          recording.data.role === 'conductor'
                            ? 'bg-primary/10 text-primary'
                            : 'bg-amber-500/10 text-amber-600 dark:text-amber-400',
                        ]}
                      >
                        {recording.data.role || 'Conductor'}
                      </span>
                    </div>

                    <div class="text-xs text-muted-foreground mb-2">
                      {recording.data.orchestra} · {recording.data.label} ·{' '}
                      {recording.data.releaseDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'short',
                      })}
                    </div>

                    {recording.data.works && recording.data.works.length > 0 && (
                      <div class="text-sm font-serif italic text-muted-foreground mb-2 truncate">
                        {recording.data.works.join(' · ')}
                      </div>
                    )}

                    {recording.data.awards && recording.data.awards.length > 0 && (
                      <div class="flex flex-wrap gap-1 mb-2">
                        {recording.data.awards.map((award: string) => (
                          <Badge
                            variant="outline"
                            className="text-[10px] text-primary border-primary"
                          >
                            {award}
                          </Badge>
                        ))}
                      </div>
                    )}

                    {/* External Links */}
                    {recording.data.externalLinks && recording.data.externalLinks.length > 0 && (
                      <MediaLinks
                        links={recording.data.externalLinks.slice(0, 3)}
                        variant="inline"
                        class="mt-2"
                      />
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  function initRecordingFilters() {
    const filterBtns = document.querySelectorAll('#role-filter .filter-btn');
    const recordingItems = document.querySelectorAll('.recording-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update button states
        filterBtns.forEach((b) => {
          b.classList.remove('text-foreground', 'border-b', 'border-primary');
          b.classList.add('text-muted-foreground');
        });
        btn.classList.remove('text-muted-foreground');
        btn.classList.add('text-foreground', 'border-b', 'border-primary');

        // Filter items
        recordingItems.forEach((item) => {
          const role = item.getAttribute('data-role');
          const isPerforming = role === 'musician' || role === 'soloist' || role === 'collaborator';

          if (filter === 'all') {
            item.classList.remove('hidden');
          } else if (filter === 'conductor') {
            item.classList.toggle('hidden', role !== 'conductor');
          } else if (filter === 'musician') {
            item.classList.toggle('hidden', !isPerforming);
          }
        });
      });
    });
  }

  initRecordingFilters();
  document.addEventListener('astro:after-swap', initRecordingFilters);
</script>
