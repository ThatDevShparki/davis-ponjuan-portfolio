---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Davis Ponjuán - Conductor', description = 'Conductor and musician' } = Astro.props;

// Get current path for active nav indication
const currentPath = new URL(Astro.request.url).pathname;

// Core navigation items (header)
const navItems = [
  { href: '/home', label: 'Home', match: (p: string) => p === '/home' },
  { href: '/about', label: 'About', match: (p: string) => p === '/about' },
  { href: '/concerts', label: 'Concerts', match: (p: string) => p.startsWith('/concerts') },
  { href: '/repertoire', label: 'Repertoire', match: (p: string) => p === '/repertoire' },
  { href: '/workshops', label: 'Workshops', match: (p: string) => p === '/workshops' },
  { href: '/press', label: 'Press', match: (p: string) => p === '/press' },
];

// Footer link groups
const footerLinks = {
  performances: [
    { href: '/concerts', label: 'Concerts' },
    { href: '/repertoire', label: 'Repertoire' },
    { href: '/recordings', label: 'Recordings' },
  ],
  about: [
    { href: '/about', label: 'Biography' },
    { href: '/organizations', label: 'Organizations' },
    { href: '/workshops', label: 'Workshops' },
    { href: '/press', label: 'Press & Reviews' },
  ],
  connect: [
    { href: '/contact', label: 'Contact' },
    { href: '/cv', label: 'Curriculum Vitae' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />

    {/* Preconnect to external domains for faster resource loading */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />

    {/* DNS prefetch for external resources */}
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />

    {/* Prefetch likely navigation targets for faster page transitions */}
    <link rel="prefetch" href="/about" />
    <link rel="prefetch" href="/concerts" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Non-blocking font loading with swap display */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      />
    </noscript>
  </head>
  <body>
    <a
      href="#main-content"
      aria-label="Skip to main content"
      id="scroll-button"
      class="fixed bottom-4 right-4 md:bottom-6 md:right-6 z-50 size-12 md:size-11 rounded-full bg-primary text-primary-foreground flex items-center justify-center opacity-0 pointer-events-none shadow-lg hover:bg-primary/90 hover:scale-110 hover:-translate-y-0.5 active:scale-95 transition-all duration-300 print-hidden no-underline"
    >
      <svg
        id="chevron-down"
        class="w-5 h-5"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
      <svg
        id="chevron-up"
        class="w-5 h-5 hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </a>

    <header
      class="fixed top-0 left-0 right-0 z-40 bg-background/80 backdrop-blur-md border-b border-border/50 print-hidden"
    >
      <nav
        aria-label="Main navigation"
        class="max-w-6xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16 py-3 md:py-4 flex items-center justify-between"
      >
        {/* Logo/Name - always visible, full name on desktop */}
        <a
          href="/home"
          class="font-serif text-lg leading-none flex items-center hover:text-primary transition-colors duration-300"
        >
          <span class="md:hidden">DP</span>
          <span class="hidden md:inline">Davis Ponjuán</span>
        </a>

        {/* Mobile hamburger button */}
        <button
          type="button"
          id="mobile-menu-toggle"
          class="md:hidden flex items-center justify-center w-11 h-11 -mr-2 rounded-md hover:bg-muted active:bg-muted/80 transition-colors"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="menu-icon"
            class="w-6 h-6 transition-transform duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden transition-transform duration-200"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>

        {/* Desktop navigation */}
        <div class="hidden md:flex gap-5 lg:gap-6 items-center">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                aria-current={item.match(currentPath) ? 'page' : undefined}
                class="text-nav text-muted-foreground hover:text-foreground transition-colors duration-300 aria-[current=page]:text-foreground aria-[current=page]:border-b aria-[current=page]:border-primary pb-0.5"
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    {/* Mobile navigation - Full screen overlay (outside header for proper stacking) */}
    <div
      id="mobile-menu"
      class="md:hidden fixed inset-x-0 top-12 bottom-0 bg-background z-50 hidden opacity-0 transition-opacity duration-300"
      style="will-change: opacity;"
    >
      <div class="h-full overflow-y-auto overscroll-contain pb-safe">
        <div class="px-5 py-6">
          {/* Primary Navigation */}
          <div class="space-y-1">
            {
              navItems.map((item, index) => (
                <a
                  href={item.href}
                  aria-current={item.match(currentPath) ? 'page' : undefined}
                  class="mobile-nav-item group flex items-center justify-between py-4 px-4 text-xl font-serif rounded-lg text-foreground hover:bg-muted/50 active:bg-muted transition-all duration-200 aria-[current=page]:text-primary aria-[current=page]:bg-primary/5"
                  style={`animation-delay: ${index * 50}ms`}
                >
                  <span>{item.label}</span>
                  <svg
                    class="w-5 h-5 text-muted-foreground group-hover:text-foreground group-hover:translate-x-0.5 transition-all duration-200"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              ))
            }
          </div>

          {/* Divider */}
          <div class="py-5">
            <hr class="border-border" />
          </div>

          {/* Secondary Navigation */}
          <div class="space-y-1">
            <p class="px-4 text-xs uppercase tracking-wider text-muted-foreground mb-3">More</p>
            {
              [
                { href: '/recordings', label: 'Recordings' },
                { href: '/organizations', label: 'Organizations' },
                { href: '/cv', label: 'Curriculum Vitae' },
              ].map((item) => (
                <a
                  href={item.href}
                  class="flex items-center py-3.5 px-4 text-lg text-foreground/80 hover:text-foreground hover:bg-muted/50 active:bg-muted rounded-lg transition-colors duration-200"
                >
                  {item.label}
                </a>
              ))
            }
          </div>

          {/* Contact CTA - subtle editorial style */}
          <div class="pt-6">
            <a
              href="/contact"
              class="group flex items-center justify-between py-4 px-4 text-lg font-serif text-foreground border border-border rounded-lg hover:border-primary hover:text-primary active:bg-muted/30 transition-all duration-200"
            >
              <span>Get in Touch</span>
              <svg
                class="w-5 h-5 text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 transition-all duration-200"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Spacer for fixed header -->
    <div class="h-12 md:h-14 print-hidden"></div>

    <main
      id="main-content"
      tabindex="-1"
      class="max-w-6xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16 py-8 md:py-14 min-h-[calc(100vh-160px)] print-full-width"
    >
      <slot />
    </main>

    <footer class="border-t border-border print-hidden">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-10 lg:px-16 py-10 md:py-16">
        <!-- Footer Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
          <!-- Brand Column -->
          <div class="sm:col-span-2 md:col-span-1">
            <a
              href="/home"
              class="text-xl font-serif hover:text-primary transition-colors duration-300"
            >
              Davis Ponjuán
            </a>
            <p class="text-sm text-muted-foreground mt-2">Conductor · Musician · Educator</p>
          </div>

          <!-- Performances Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">Performances</h3>
            <ul class="list-none p-0 m-0 space-y-3">
              {
                footerLinks.performances.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm py-1 inline-block hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- About Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">About</h3>
            <ul class="list-none p-0 m-0 space-y-3">
              {
                footerLinks.about.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm py-1 inline-block hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Connect Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">Connect</h3>
            <ul class="list-none p-0 m-0 space-y-3">
              {
                footerLinks.connect.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm py-1 inline-block hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div
          class="mt-10 md:mt-12 pt-6 border-t border-border flex flex-col md:flex-row justify-between items-center gap-3 text-center md:text-left"
        >
          <p class="text-xs text-muted-foreground">
            &copy; {new Date().getFullYear()} Davis Ponjuán. All rights reserved.
          </p>
          <p class="text-xs text-muted-foreground">
            For conducting engagements, <a
              href="/contact"
              class="text-primary hover:underline underline-offset-2">send an inquiry</a
            >.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const scrollButton = document.getElementById('scroll-button');
      const chevronDown = document.getElementById('chevron-down');
      const chevronUp = document.getElementById('chevron-up');

      let isHoveringNearButton = false;
      let isActivelyScrolling = false;
      let scrollTimeout: number;
      const scrollThreshold = 100; // Header height

      function updateButtonState() {
        if (!scrollButton || !chevronDown || !chevronUp) return;

        const scrollPosition = window.scrollY;
        const isAtTop = scrollPosition <= scrollThreshold;

        // Determine if button should be visible and which icon to show
        let shouldShow = false;
        let useDownChevron = true;

        if (isAtTop) {
          // At top: show down chevron to skip to content
          shouldShow = true;
          useDownChevron = true;
          scrollButton.setAttribute('href', '#main-content');
          scrollButton.setAttribute('aria-label', 'Skip to main content');
        } else if (isActivelyScrolling) {
          // Actively scrolling: show up chevron to go back to top
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else if (isHoveringNearButton) {
          // Hovering: show up chevron (since we're scrolled down)
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else {
          // Default: hide (don't change icon when hiding)
          shouldShow = false;
        }

        // Update icon BEFORE changing visibility (prevents flash)
        if (shouldShow) {
          if (useDownChevron) {
            chevronDown.classList.remove('hidden');
            chevronUp.classList.add('hidden');
          } else {
            chevronDown.classList.add('hidden');
            chevronUp.classList.remove('hidden');
          }
        }

        // Update visibility
        if (shouldShow) {
          scrollButton.classList.remove('opacity-0', 'pointer-events-none');
          scrollButton.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          scrollButton.classList.add('opacity-0', 'pointer-events-none');
          scrollButton.classList.remove('opacity-100', 'pointer-events-auto');
        }
      }

      function handleScroll() {
        // Mark as actively scrolling
        isActivelyScrolling = true;
        updateButtonState();

        // Clear previous timeout
        clearTimeout(scrollTimeout);

        // Hide button 1 second after scrolling stops
        scrollTimeout = window.setTimeout(() => {
          isActivelyScrolling = false;
          updateButtonState();
        }, 1000);
      }

      function handleMouseMove(e: MouseEvent) {
        const hoverRegionSize = 200; // pixels from edge
        const isNearBottom = window.innerHeight - e.clientY < hoverRegionSize;
        const isNearRight = window.innerWidth - e.clientX < hoverRegionSize;

        const wasHovering = isHoveringNearButton;
        isHoveringNearButton = isNearBottom && isNearRight;

        // Only update if hover state changed
        if (wasHovering !== isHoveringNearButton) {
          updateButtonState();
        }
      }

      // Smooth scroll to top when clicking the back-to-top button
      scrollButton?.addEventListener('click', (e) => {
        if (scrollButton.getAttribute('href') === '#') {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      // Use passive listeners for better scroll performance
      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('mousemove', handleMouseMove, { passive: true });
      updateButtonState();

      // Mobile menu toggle with animation
      const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const menuIcon = document.getElementById('menu-icon');
      const closeIcon = document.getElementById('close-icon');
      let isMenuOpen = false;

      function openMobileMenu() {
        if (!mobileMenu || isMenuOpen) return;
        isMenuOpen = true;

        // Show menu container
        mobileMenu.classList.remove('hidden');

        // Trigger animation on next frame
        requestAnimationFrame(() => {
          mobileMenu.classList.remove('opacity-0');
          mobileMenu.classList.add('opacity-100');
        });

        // Update icons with rotation
        menuIcon?.classList.add('hidden', 'rotate-90');
        closeIcon?.classList.remove('hidden');
        closeIcon?.classList.add('rotate-0');

        // Update ARIA
        mobileMenuToggle?.setAttribute('aria-expanded', 'true');

        // Lock body scroll
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        if (!mobileMenu || !isMenuOpen) return;
        isMenuOpen = false;

        // Fade out
        mobileMenu.classList.remove('opacity-100');
        mobileMenu.classList.add('opacity-0');

        // Update icons
        menuIcon?.classList.remove('hidden', 'rotate-90');
        closeIcon?.classList.add('hidden');

        // Update ARIA
        mobileMenuToggle?.setAttribute('aria-expanded', 'false');

        // Unlock body scroll
        document.body.style.overflow = '';

        // Hide after animation
        setTimeout(() => {
          if (!isMenuOpen) {
            mobileMenu.classList.add('hidden');
          }
        }, 300);
      }

      function toggleMobileMenu() {
        if (isMenuOpen) {
          closeMobileMenu();
        } else {
          openMobileMenu();
        }
      }

      mobileMenuToggle?.addEventListener('click', toggleMobileMenu);

      // Close menu when clicking a link
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          closeMobileMenu();
        });
      });

      // Close menu on resize to desktop
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && isMenuOpen) {
          closeMobileMenu();
        }
      });

      // Close menu on escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isMenuOpen) {
          closeMobileMenu();
          mobileMenuToggle?.focus();
        }
      });

      // Handle back button (for mobile browsers)
      window.addEventListener('popstate', () => {
        if (isMenuOpen) {
          closeMobileMenu();
        }
      });
    </script>
  </body>
</html>
