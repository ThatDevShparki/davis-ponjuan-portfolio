---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Davis Ponjuan - Conductor', description = 'Conductor and musician' } = Astro.props;

// Get current path for active nav indication
const currentPath = new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header>
      <nav aria-label="Main navigation">
        <a href="/home" aria-current={currentPath === '/home' ? 'page' : undefined}>Home</a>
        <a href="/about" aria-current={currentPath === '/about' ? 'page' : undefined}>About</a>
        <a href="/concerts" aria-current={currentPath.startsWith('/concerts') ? 'page' : undefined}
          >Concerts</a
        >
        <a href="/repertoire" aria-current={currentPath === '/repertoire' ? 'page' : undefined}
          >Repertoire</a
        >
        <a
          href="/organizations"
          aria-current={currentPath === '/organizations' ? 'page' : undefined}>Organizations</a
        >
        <a href="/recordings" aria-current={currentPath === '/recordings' ? 'page' : undefined}
          >Recordings</a
        >
        <a href="/workshops" aria-current={currentPath === '/workshops' ? 'page' : undefined}
          >Workshops</a
        >
        <a href="/press" aria-current={currentPath === '/press' ? 'page' : undefined}>Press</a>
        <a href="/cv" aria-current={currentPath === '/cv' ? 'page' : undefined}>CV</a>
        <a href="/contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>Contact</a
        >
      </nav>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <footer>
      <p>&copy; {new Date().getFullYear()} Davis Ponjuan. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: #2d7a3e;
    color: white;
    padding: 0.5rem 1rem;
    text-decoration: none;
    z-index: 100;
  }

  .skip-link:focus {
    top: 0;
  }

  header {
    padding: 1rem 2rem;
    border-bottom: 1px solid #ddd;
  }

  nav {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  nav a {
    text-decoration: none;
    color: #333;
  }

  nav a:hover {
    text-decoration: underline;
  }

  nav a[aria-current='page'] {
    font-weight: 600;
    color: #2d7a3e;
  }

  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 200px);
  }

  footer {
    padding: 2rem;
    text-align: center;
    border-top: 1px solid #ddd;
    color: #666;
  }

  @media print {
    header,
    footer {
      display: none;
    }

    main {
      max-width: 100%;
      margin: 0;
      padding: 0;
      min-height: auto;
    }
  }
</style>
