---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Davis Ponjuan - Conductor', description = 'Conductor and musician' } = Astro.props;

// Get current path for active nav indication
const currentPath = new URL(Astro.request.url).pathname;

// Core navigation items (header)
const navItems = [
  { href: '/home', label: 'Home', match: (p: string) => p === '/home' },
  { href: '/about', label: 'About', match: (p: string) => p === '/about' },
  { href: '/concerts', label: 'Concerts', match: (p: string) => p.startsWith('/concerts') },
  { href: '/repertoire', label: 'Repertoire', match: (p: string) => p === '/repertoire' },
  { href: '/workshops', label: 'Workshops', match: (p: string) => p === '/workshops' },
  { href: '/press', label: 'Press', match: (p: string) => p === '/press' },
];

// Footer link groups
const footerLinks = {
  performances: [
    { href: '/concerts', label: 'Concerts' },
    { href: '/repertoire', label: 'Repertoire' },
    { href: '/recordings', label: 'Recordings' },
  ],
  about: [
    { href: '/about', label: 'Biography' },
    { href: '/organizations', label: 'Organizations' },
    { href: '/workshops', label: 'Workshops' },
    { href: '/press', label: 'Press & Reviews' },
  ],
  connect: [
    { href: '/contact', label: 'Contact' },
    { href: '/cv', label: 'Curriculum Vitae' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main-content"
      aria-label="Skip to main content"
      id="scroll-button"
      class="fixed bottom-6 right-6 z-50 size-10 rounded-full bg-primary text-primary-foreground flex items-center justify-center opacity-0 pointer-events-none shadow-lg hover:bg-primary/90 hover:scale-110 hover:-translate-y-0.5 transition-all duration-300 print-hidden no-underline"
    >
      <svg
        id="chevron-down"
        class="w-5 h-5"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m6 9 6 6 6-6"></path>
      </svg>
      <svg
        id="chevron-up"
        class="w-5 h-5 hidden"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </a>

    <header class="border-b border-border print-hidden">
      <nav
        aria-label="Main navigation"
        class="max-w-6xl mx-auto px-6 md:px-10 lg:px-16 py-4 flex gap-5 md:gap-6 flex-wrap items-center justify-start"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.match(currentPath) ? 'page' : undefined}
              class="text-nav text-muted-foreground hover:text-foreground transition-colors duration-300 aria-[current=page]:text-foreground aria-[current=page]:border-b aria-[current=page]:border-primary pb-0.5"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main
      id="main-content"
      tabindex="-1"
      class="max-w-6xl mx-auto px-6 md:px-10 lg:px-16 py-10 md:py-14 min-h-[calc(100vh-160px)] print-full-width"
    >
      <slot />
    </main>

    <footer class="border-t border-border print-hidden">
      <div class="max-w-6xl mx-auto px-6 md:px-10 lg:px-16 py-12 md:py-16">
        <!-- Footer Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
          <!-- Brand Column -->
          <div class="col-span-2 md:col-span-1">
            <a
              href="/home"
              class="text-xl font-serif hover:text-primary transition-colors duration-300"
            >
              Davis Ponjuan
            </a>
            <p class="text-sm text-muted-foreground mt-2">Conductor · Music Director · Educator</p>
          </div>

          <!-- Performances Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">Performances</h3>
            <ul class="list-none p-0 m-0 space-y-2">
              {
                footerLinks.performances.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- About Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">About</h3>
            <ul class="list-none p-0 m-0 space-y-2">
              {
                footerLinks.about.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Connect Column -->
          <div>
            <h3 class="text-nav text-muted-foreground mb-3">Connect</h3>
            <ul class="list-none p-0 m-0 space-y-2">
              {
                footerLinks.connect.map((link) => (
                  <li class="m-0">
                    <a
                      href={link.href}
                      class="text-sm hover:text-primary transition-colors duration-300"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div
          class="mt-12 pt-6 border-t border-border flex flex-col md:flex-row justify-between items-center gap-4"
        >
          <p class="text-xs text-muted-foreground">
            &copy; {new Date().getFullYear()} Davis Ponjuan. All rights reserved.
          </p>
          <p class="text-xs text-muted-foreground">
            For booking inquiries, please <a
              href="/contact"
              class="text-primary hover:underline underline-offset-2">get in touch</a
            >.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const scrollButton = document.getElementById('scroll-button');
      const chevronDown = document.getElementById('chevron-down');
      const chevronUp = document.getElementById('chevron-up');
      const mainContent = document.getElementById('main-content');

      let isHoveringNearButton = false;
      let isActivelyScrolling = false;
      let scrollTimeout: number;
      const scrollThreshold = 100; // Header height

      function updateButtonState() {
        if (!scrollButton || !chevronDown || !chevronUp) return;

        const scrollPosition = window.scrollY;
        const isAtTop = scrollPosition <= scrollThreshold;

        // Determine if button should be visible and which icon to show
        let shouldShow = false;
        let useDownChevron = true;

        if (isAtTop) {
          // At top: show down chevron to skip to content
          shouldShow = true;
          useDownChevron = true;
          scrollButton.setAttribute('href', '#main-content');
          scrollButton.setAttribute('aria-label', 'Skip to main content');
        } else if (isActivelyScrolling) {
          // Actively scrolling: show up chevron to go back to top
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else if (isHoveringNearButton) {
          // Hovering: show up chevron (since we're scrolled down)
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else {
          // Default: hide (don't change icon when hiding)
          shouldShow = false;
        }

        // Update icon BEFORE changing visibility (prevents flash)
        if (shouldShow) {
          if (useDownChevron) {
            chevronDown.classList.remove('hidden');
            chevronUp.classList.add('hidden');
          } else {
            chevronDown.classList.add('hidden');
            chevronUp.classList.remove('hidden');
          }
        }

        // Update visibility
        if (shouldShow) {
          scrollButton.classList.remove('opacity-0', 'pointer-events-none');
          scrollButton.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          scrollButton.classList.add('opacity-0', 'pointer-events-none');
          scrollButton.classList.remove('opacity-100', 'pointer-events-auto');
        }
      }

      function handleScroll() {
        // Mark as actively scrolling
        isActivelyScrolling = true;
        updateButtonState();

        // Clear previous timeout
        clearTimeout(scrollTimeout);

        // Hide button 1 second after scrolling stops
        scrollTimeout = window.setTimeout(() => {
          isActivelyScrolling = false;
          updateButtonState();
        }, 1000);
      }

      function handleMouseMove(e: MouseEvent) {
        const hoverRegionSize = 200; // pixels from edge
        const isNearBottom = window.innerHeight - e.clientY < hoverRegionSize;
        const isNearRight = window.innerWidth - e.clientX < hoverRegionSize;

        const wasHovering = isHoveringNearButton;
        isHoveringNearButton = isNearBottom && isNearRight;

        // Only update if hover state changed
        if (wasHovering !== isHoveringNearButton) {
          updateButtonState();
        }
      }

      // Smooth scroll to top when clicking the back-to-top button
      scrollButton?.addEventListener('click', (e) => {
        if (scrollButton.getAttribute('href') === '#') {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      window.addEventListener('scroll', handleScroll);
      window.addEventListener('mousemove', handleMouseMove);
      updateButtonState();
    </script>
  </body>
</html>
