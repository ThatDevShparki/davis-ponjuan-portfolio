---
import '../styles/global.css';

import { ChevronDown, ChevronUp } from 'lucide-react';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Davis Ponjuan - Conductor', description = 'Conductor and musician' } = Astro.props;

// Get current path for active nav indication
const currentPath = new URL(Astro.request.url).pathname;

const navLinkClass =
  'no-underline text-foreground hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-primary';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#main-content"
      id="scroll-button"
      class="fixed bottom-6 right-6 bg-primary text-primary-foreground p-3 rounded-full no-underline z-50 opacity-0 pointer-events-none transition-all duration-300 shadow-lg hover:scale-110 print-hidden"
      aria-label="Skip to main content"
    >
      <ChevronDown className="w-5 h-5" id="chevron-down" />
      <ChevronUp className="w-5 h-5 hidden" id="chevron-up" />
    </a>
    <header class="py-4 px-8 border-b border-border print-hidden">
      <nav aria-label="Main navigation" class="flex gap-8 flex-wrap">
        <a
          href="/home"
          aria-current={currentPath === '/home' ? 'page' : undefined}
          class={navLinkClass}>Home</a
        >
        <a
          href="/about"
          aria-current={currentPath === '/about' ? 'page' : undefined}
          class={navLinkClass}>About</a
        >
        <a
          href="/concerts"
          aria-current={currentPath.startsWith('/concerts') ? 'page' : undefined}
          class={navLinkClass}>Concerts</a
        >
        <a
          href="/repertoire"
          aria-current={currentPath === '/repertoire' ? 'page' : undefined}
          class={navLinkClass}>Repertoire</a
        >
        <a
          href="/organizations"
          aria-current={currentPath === '/organizations' ? 'page' : undefined}
          class={navLinkClass}>Organizations</a
        >
        <a
          href="/recordings"
          aria-current={currentPath === '/recordings' ? 'page' : undefined}
          class={navLinkClass}>Recordings</a
        >
        <a
          href="/workshops"
          aria-current={currentPath === '/workshops' ? 'page' : undefined}
          class={navLinkClass}>Workshops</a
        >
        <a
          href="/press"
          aria-current={currentPath === '/press' ? 'page' : undefined}
          class={navLinkClass}>Press</a
        >
        <a href="/cv" aria-current={currentPath === '/cv' ? 'page' : undefined} class={navLinkClass}
          >CV</a
        >
        <a
          href="/contact"
          aria-current={currentPath === '/contact' ? 'page' : undefined}
          class={navLinkClass}>Contact</a
        >
      </nav>
    </header>

    <main
      id="main-content"
      tabindex="-1"
      class="max-w-6xl mx-auto p-8 min-h-[calc(100vh-200px)] print-full-width"
    >
      <slot />
    </main>

    <footer class="p-8 text-center border-t border-border text-muted-foreground print-hidden">
      <p>&copy; {new Date().getFullYear()} Davis Ponjuan. All rights reserved.</p>
    </footer>

    <script>
      const scrollButton = document.getElementById('scroll-button');
      const chevronDown = document.getElementById('chevron-down');
      const chevronUp = document.getElementById('chevron-up');
      const mainContent = document.getElementById('main-content');

      let isHoveringNearButton = false;
      let isActivelyScrolling = false;
      let scrollTimeout: number;
      const scrollThreshold = 100; // Header height

      function updateButtonState() {
        if (!scrollButton || !chevronDown || !chevronUp) return;

        const scrollPosition = window.scrollY;
        const isAtTop = scrollPosition <= scrollThreshold;

        // Determine if button should be visible and which icon to show
        let shouldShow = false;
        let useDownChevron = true;

        if (isAtTop) {
          // At top: show down chevron to skip to content
          shouldShow = true;
          useDownChevron = true;
          scrollButton.setAttribute('href', '#main-content');
          scrollButton.setAttribute('aria-label', 'Skip to main content');
        } else if (isActivelyScrolling) {
          // Actively scrolling: show up chevron to go back to top
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else if (isHoveringNearButton) {
          // Hovering: show up chevron (since we're scrolled down)
          shouldShow = true;
          useDownChevron = false;
          scrollButton.setAttribute('href', '#');
          scrollButton.setAttribute('aria-label', 'Back to top');
        } else {
          // Default: hide (don't change icon when hiding)
          shouldShow = false;
        }

        // Update icon BEFORE changing visibility (prevents flash)
        if (shouldShow) {
          if (useDownChevron) {
            chevronDown.classList.remove('hidden');
            chevronUp.classList.add('hidden');
          } else {
            chevronDown.classList.add('hidden');
            chevronUp.classList.remove('hidden');
          }
        }

        // Update visibility
        if (shouldShow) {
          scrollButton.classList.remove('opacity-0', 'pointer-events-none');
          scrollButton.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          scrollButton.classList.add('opacity-0', 'pointer-events-none');
          scrollButton.classList.remove('opacity-100', 'pointer-events-auto');
        }
      }

      function handleScroll() {
        // Mark as actively scrolling
        isActivelyScrolling = true;
        updateButtonState();

        // Clear previous timeout
        clearTimeout(scrollTimeout);

        // Hide button 1 second after scrolling stops
        scrollTimeout = window.setTimeout(() => {
          isActivelyScrolling = false;
          updateButtonState();
        }, 1000);
      }

      function handleMouseMove(e: MouseEvent) {
        const hoverRegionSize = 200; // pixels from edge
        const isNearBottom = window.innerHeight - e.clientY < hoverRegionSize;
        const isNearRight = window.innerWidth - e.clientX < hoverRegionSize;

        const wasHovering = isHoveringNearButton;
        isHoveringNearButton = isNearBottom && isNearRight;

        // Only update if hover state changed
        if (wasHovering !== isHoveringNearButton) {
          updateButtonState();
        }
      }

      // Smooth scroll to top when clicking the back-to-top button
      scrollButton?.addEventListener('click', (e) => {
        if (scrollButton.getAttribute('href') === '#') {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      });

      window.addEventListener('scroll', handleScroll);
      window.addEventListener('mousemove', handleMouseMove);
      updateButtonState();
    </script>
  </body>
</html>
